@model IEnumerable<NotificationDto>
@{
    ViewData["Title"] = "Notifications";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="fas fa-bell me-2 text-warning"></i> Notifications</h2>
        <div>
            <button id="markAllReadBtn" class="btn btn-outline-primary me-2" onclick="markAllAsRead()">
                <i class="fas fa-check-double me-1"></i> Mark All as Read
            </button>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="fas fa-bell-slash fa-4x mb-3"></i>
            <h5>No notifications</h5>
            <p>You're all caught up! Check back later for updates.</p>
        </div>
    }
    else
    {
        <div class="card shadow">
            <div class="list-group list-group-flush" id="notificationList">
                @foreach (var notif in Model)
                {
                    <div class="list-group-item list-group-item-action @(notif.IsRead ? "" : "fw-bold bg-light")" id="notif-@notif.Id">
                        <div class="d-flex w-100 justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center mb-1">
                                    @if (!notif.IsRead)
                                    {
                                        <span class="badge bg-danger rounded-pill me-2" style="width: 8px; height: 8px; padding: 0;">&nbsp;</span>
                                    }
                                    <strong>@notif.Title</strong>
                                    <span class="badge bg-secondary ms-2">@notif.Type</span>
                                </div>
                                <p class="mb-1">@notif.Message</p>
                                <small class="text-muted">
                                    <i class="fas fa-clock me-1"></i> @notif.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                    @if (notif.IsRead)
                                    {
                                        <span class="ms-2">· Read @notif.ReadAt?.ToString("MMM dd HH:mm")</span>
                                    }
                                </small>
                            </div>
                            <div class="ms-3 d-flex flex-column align-items-end">
                                @if (!string.IsNullOrEmpty(notif.LinkUrl))
                                {
                                    <a href="@notif.LinkUrl" class="btn btn-sm btn-outline-primary mb-1">
                                        <i class="fas fa-external-link-alt"></i> View
                                    </a>
                                }
                                @if (!notif.IsRead)
                                {
                                    <button class="btn btn-sm btn-outline-success" onclick="markAsRead(@notif.Id)">
                                        <i class="fas fa-check"></i> Mark Read
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<div class="text-center mt-3">
    <a asp-controller="Home" asp-action="Index" class="btn-back-pill">
        <i class="fas fa-chevron-left"></i> Back
    </a>
</div>

@section Scripts {
    <script>
        function markAsRead(id) {
            $.post('/Notification/MarkAsRead', { id: id })
                .done(function () {
                    const item = $(`#notif-${id}`);
                    item.removeClass('fw-bold bg-light');
                    item.find('.badge.bg-danger').remove();
                    item.find('button:contains("Mark Read")')
                        .removeClass('btn-outline-success')
                        .addClass('btn-outline-secondary')
                        .prop('disabled', true)
                        .html('<i class="fas fa-check"></i> Read');
                })
                .fail(function () {
                    alert('Failed to mark notification as read.');
                });
        }

        function markAllAsRead() {
            $.post('/Notification/MarkAllAsRead')
                .done(function () {
                    $('#notificationList .list-group-item').each(function () {
                        $(this).removeClass('fw-bold bg-light');
                        $(this).find('.badge.bg-danger').remove();
                        $(this).find('button:contains("Mark Read")')
                            .removeClass('btn-outline-success')
                            .addClass('btn-outline-secondary')
                            .prop('disabled', true)
                            .html('<i class="fas fa-check"></i> Read');
                    });
                    $('#markAllReadBtn').prop('disabled', true).html('<i class="fas fa-check-double me-1"></i> All Read');
                })
                .fail(function () {
                    alert('Failed to mark all as read.');
                });
        }
    </script>
}
