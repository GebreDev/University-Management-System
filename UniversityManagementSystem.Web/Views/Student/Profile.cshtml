@model StudentViewDto
@{
    ViewData["Title"] = "My Profile";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-lg-4">
            <!-- Profile Picture Card -->
            <div class="card shadow-sm border-0 rounded-3 mb-4">
                <div class="card-body text-center p-4">
                    <div class="position-relative d-inline-block">
                        <div class="avatar-wrapper mx-auto mb-3" style="width: 160px; height: 160px; border-radius: 50%; overflow: hidden; border: 4px solid #e9ecef; background: #f8f9fa; position: relative;">
                            @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                            {
                                <img src="@Model.ProfilePictureUrl" alt="Profile" class="w-100 h-100" style="object-fit: cover;" id="studentProfileImg" />
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center h-100 stat-grad-a">
                                    <i class="fas fa-user-graduate fa-4x text-white opacity-75"></i>
                                </div>
                            }
                        </div>
                        <label for="profileUpload" class="btn btn-sm btn-primary rounded-circle position-absolute" style="bottom: 5px; right: 5px; width: 36px; height: 36px; cursor: pointer;">
                            <i class="fas fa-camera"></i>
                        </label>
                        <form id="uploadForm" asp-action="UploadProfilePicture" asp-controller="Account" method="post" enctype="multipart/form-data" style="display:none;">
                            @Html.AntiForgeryToken()
                            <input type="file" id="profileUpload" name="ImageFile" accept="image/*" class="d-none" onchange="this.form.submit()" />
                        </form>
                    </div>
                    <h5 class="fw-bold mt-2 mb-1">@string.Join(" ", new[] { Model.FirstName, Model.MiddleName, Model.LastName }.Where(name => !string.IsNullOrWhiteSpace(name)))</h5>
                    <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill">
                        <i class="fas fa-id-card me-1"></i> @Model.StudentId
                    </span>
                </div>
            </div>

            <!-- Quick Stats Card -->
            <div class="card shadow-sm border-0 rounded-3 mb-4">
                <div class="card-body">
                    <h6 class="fw-bold text-uppercase small text-muted mb-3"><i class="fas fa-chart-simple me-2"></i>Quick Stats</h6>
                    <div class="d-flex align-items-center mb-2">
                        <div class="rounded-circle bg-primary bg-opacity-10 p-2 me-3">
                            <i class="fas fa-calendar-check text-primary"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block">Enrolled</small>
                            <strong>@Model.EnrollmentDate.ToShortDateString()</strong>
                        </div>
                    </div>
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-success bg-opacity-10 p-2 me-3">
                            <i class="fas fa-building text-success"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block">Department</small>
                            <strong>@Model.DepartmentName</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <!-- Profile Details Card -->
            <div class="card shadow-sm border-0 rounded-3 mb-4">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <h5 class="fw-bold mb-0"><i class="fas fa-user me-2 text-primary"></i>Profile Details</h5>
                </div>
                <div class="card-body px-4 pb-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label text-muted small text-uppercase fw-semibold">User Name</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fas fa-at text-muted"></i></span>
                                <input type="text" class="form-control bg-light border-start-0" value="@Model.UserName" readonly />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small text-uppercase fw-semibold">First Name</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fas fa-user text-muted"></i></span>
                                <input type="text" class="form-control bg-light border-start-0" value="@Model.FirstName" readonly />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small text-uppercase fw-semibold">Middle Name</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fas fa-user text-muted"></i></span>
                                <textarea class="form-control bg-light border-start-0" rows="1" style="height: 38px; min-height: 38px; resize: none;" readonly>@Model.MiddleName</textarea>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small text-uppercase fw-semibold">Last Name</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fas fa-user text-muted"></i></span>
                                <input type="text" class="form-control bg-light border-start-0" value="@Model.LastName" readonly />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small text-uppercase fw-semibold">Email</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fas fa-envelope text-muted"></i></span>
                                <input type="text" class="form-control bg-light border-start-0" value="@Model.Email" readonly />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small text-uppercase fw-semibold">Phone</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fas fa-phone text-muted"></i></span>
                                <input type="text" class="form-control bg-light border-start-0" value="@Model.Phone" readonly />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small text-uppercase fw-semibold">Department</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fas fa-building text-muted"></i></span>
                                <input type="text" class="form-control bg-light border-start-0" value="@Model.DepartmentName" readonly />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small text-uppercase fw-semibold">Enrollment Date</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fas fa-calendar text-muted"></i></span>
                                <input type="text" class="form-control bg-light border-start-0" value="@Model.EnrollmentDate.ToString("MMMM dd, yyyy")" readonly />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Account Actions -->
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <h5 class="fw-bold mb-0"><i class="fas fa-shield-alt me-2 text-success"></i>Account</h5>
                </div>
                <div class="card-body px-4 pb-4">
                    <div class="d-flex flex-wrap gap-2">                         <a asp-action="ChangePassword" asp-controller="Account" class="btn btn-outline-primary">
                            <i class="fas fa-key me-2"></i>Change Password
                        </a>                         <a asp-action="Dashboard" class="btn-back-pill">
                            <i class="fas fa-chevron-left"></i>Back
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('profileUpload')?.addEventListener('change', function(e) {
            if (e.target.files && e.target.files[0]) {
                var reader = new FileReader();
                reader.onload = function(ev) {
                    var img = document.getElementById('studentProfileImg');
                    if (!img) {
                        var wrapper = document.querySelector('.avatar-wrapper');
                        wrapper.innerHTML = '<img src="' + ev.target.result + '" alt="Profile" class="w-100 h-100" style="object-fit: cover;" id="studentProfileImg" />';
                    } else {
                        img.src = ev.target.result;
                    }
                }
                reader.readAsDataURL(e.target.files[0]);
            }
        });
    </script>
}
