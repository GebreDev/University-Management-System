@model IEnumerable<UniversityManagementSystem.Application.DTOs.Course.CourseListDto>
@{
    ViewData["Title"] = "My Courses";
    var enrollmentCount = (int)(ViewData["EnrollmentCount"] ?? 0);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="page-title mb-0">My Courses</h1>
    <a asp-controller="Registration" asp-action="Index" class="btn btn-primary">
        <i class="fas fa-file-signature me-1"></i> Register Courses
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="data-table-wrapper">
        <div class="table-empty-state">
            <i class="fas fa-book-open fa-2x mb-2 text-muted"></i>
            <p class="mb-0">You have no approved course enrollments yet.</p>
            <a asp-action="Dashboard" class="btn-back-pill mt-2"><i class="fas fa-chevron-left"></i> Back</a>
        </div>
    </div>
}
else
{
    <div class="row g-3 mb-3">
        @foreach (var c in Model)
        {
            <div class="col-xl-3 col-md-6">
                <a asp-controller="Student" asp-action="MyGrades" asp-route-courseId="@c.Id" class="text-decoration-none">
                    <div class="course-tile" data-search="@c.Title @c.Code @c.InstructorName">
                        <div class="course-tile-top">
                            <span class="course-code">@c.Code</span>
                            <span class="course-students"><i class="fas fa-chalkboard-user me-1"></i>@c.InstructorName</span>
                        </div>
                        <h6>@c.Title</h6>
                        <small class="text-muted">
                            <i class="fas fa-layer-group me-1"></i>@c.Credits credits
                            @if (!string.IsNullOrEmpty(c.DepartmentName))
                            {
                                <span class="ms-2"><i class="fas fa-building me-1"></i>@c.DepartmentName</span>
                            }
                        </small>
                    </div>
                </a>
            </div>
        }
    </div>
}

<a asp-action="Dashboard" class="btn-back-pill">
    <i class="fas fa-chevron-left"></i> Back
</a>
