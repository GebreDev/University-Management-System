@model IEnumerable<AssignmentDto>
@{
    ViewData["Title"] = "My Assignments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="page-title mb-0"><i class="fas fa-tasks me-2 text-primary"></i>My Assignments</h1>
</div>

@if (!Model.Any())
{
    <div class="data-table-wrapper">
        <div class="table-empty-state">
            <i class="fas fa-tasks fa-2x mb-2 text-muted"></i>
            <p class="mb-0">No assignments available yet.</p>
        </div>
    </div>
}
else
{
    <div class="data-table-wrapper">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr><th>Title</th><th>Course</th><th>Deadline</th><th>Status</th><th class="text-end" style="width:180px;">Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td><span class="fw-semibold">@a.Title</span></td>
                            <td>@a.CourseName</td>
                            <td>@a.Deadline.ToString("M/d/yyyy")</td>
                            <td>
                                <span class="status-indicator">
                                    <span class="circle @(a.IsPublished ? "success" : "warning")"></span>
                                    @(a.IsPublished ? "Published" : "Draft")
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="crud-actions justify-content-end">
                                    @if (a.IsPublished)
                                    {
                                        <a asp-action="SubmitAssignment" asp-route-assignmentId="@a.Id" class="btn btn-sm btn-primary"><i class="fas fa-paper-plane me-1"></i> Submit</a>
                                    }
                                    <a asp-action="AssignmentGrades" asp-route-assignmentId="@a.Id" class="btn btn-sm btn-outline-info"><i class="fas fa-chart-bar"></i> Grade</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="table-footer-count">
            <span>@Model.Count() assignment(s)</span>
        </div>
    </div>
}