@model AssignmentDto
@using UniversityManagementSystem.Domain.Enums
@{
    ViewData["Title"] = "Answer Assignment";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
<style>
    .question-card { border-left: 4px solid #198754; transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .question-card:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(0,0,0,0.1); }
    .question-number { width: 36px; height: 36px; display: inline-flex; align-items: center; justify-content: center; background: #198754; color: white; border-radius: 50%; font-weight: bold; }
    .question-card.mcq { border-left-color: #198754; }
    .question-card.truefalse { border-left-color: #0dcaf0; }
    .question-card.shortanswer { border-left-color: #4a90e2; }
    .question-card.essay { border-left-color: #ffc107; }
</style>

<div class="d-flex justify-content-between align-items-center pt-3 pb-2 mb-3 border-bottom">
    <div>
        <h2 class="fw-bold"><i class="fas fa-tasks me-2 text-success"></i> @Model.Title</h2>
        <p class="text-muted mb-0">
            <span class="badge bg-secondary">@Model.TotalMarks marks</span>
            <span class="mx-2">|</span> @Model.Questions?.Count question(s)
            <span class="mx-2">|</span> Deadline: @Model.Deadline.ToString("MMM dd, yyyy HH:mm")
            @if (Model.AllowLateSubmission)
            {
                <span class="badge bg-warning text-dark ms-2">Late OK (-@(Model.LateSubmissionPenalty ?? 0)%)</span>
            }
        </p>
    </div>
</div>

<form asp-action="SubmitAssignmentAnswers" method="post" id="assignmentForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="assignmentId" value="@Model.Id" />

    @if (Model.Questions != null && Model.Questions.Any())
    {
        var qNum = 1;
        @foreach (var question in Model.Questions)
        {
            var typeLower = question.Type.ToString().ToLower();
            <div class="card question-card shadow-sm mb-3 rounded-3 @typeLower">
                <div class="card-header bg-white py-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="question-number">@qNum</span>
                        <strong class="text-muted ms-2">@question.Marks marks</strong>
                        @if (question.Type == ExamType.MCQ)
                        {
                            <span class="badge bg-success ms-auto">MCQ</span>
                        }
                        else if (question.Type == ExamType.TrueFalse)
                        {
                            <span class="badge bg-info ms-auto">True / False</span>
                        }
                        else if (question.Type == ExamType.ShortAnswer)
                        {
                            <span class="badge bg-purple ms-auto" style="background:#4a90e2;">Short Answer</span>
                        }
                        else if (question.Type == ExamType.Essay)
                        {
                            <span class="badge bg-warning text-dark ms-auto">Essay</span>
                        }
                    </div>
                </div>
                <div class="card-body">                            <p class="fs-5 fw-medium mb-3">@question.QuestionText</p>

                    @* Difficulty Level Badge *@
                    @if (!string.IsNullOrEmpty(question.DifficultyLevel))
                    {
                        <div class="mb-2">
                            <span class="badge @(question.DifficultyLevel == "Easy" ? "bg-success" : question.DifficultyLevel == "Medium" ? "bg-warning text-dark" : "bg-danger")">
                                <i class="fas fa-signal me-1"></i> @question.DifficultyLevel
                            </span>
                        </div>
                    }

                    @* MCQ: Radio buttons *@
                    @if (question.Type == ExamType.MCQ && question.Options != null && question.Options.Any())
                    {
                        @foreach (var option in question.Options)
                        {
                            <div class="form-check py-1">
                                <input class="form-check-input" type="radio" name="answers[@question.Id]" value="@option.OptionText" id="q@(question.Id)_opt@(option.Id)" />
                                <label class="form-check-label" for="q@(question.Id)_opt@(option.Id)">@option.OptionText</label>
                            </div>
                        }
                    }

                    @* True/False: Radio buttons for True and False *@
                    @if (question.Type == ExamType.TrueFalse)
                    {
                        <div class="d-flex gap-4 mt-2">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="answers[@question.Id]" value="True" id="q@(question.Id)_true" />
                                <label class="form-check-label fw-medium" for="q@(question.Id)_true">
                                    <i class="fas fa-check-circle text-success me-1"></i> True
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="answers[@question.Id]" value="False" id="q@(question.Id)_false" />
                                <label class="form-check-label fw-medium" for="q@(question.Id)_false">
                                    <i class="fas fa-times-circle text-danger me-1"></i> False
                                </label>
                            </div>
                        </div>
                    }

                    @* Short Answer: Text input *@
                    @if (question.Type == ExamType.ShortAnswer)
                    {
                        <div class="mb-2">
                            <input type="text" name="answers[@question.Id]" class="form-control" placeholder="Type your short answer here..." />
                        </div>
                    }

                    @* Essay: Textarea *@
                    @if (question.Type == ExamType.Essay)
                    {
                        <div class="mb-2">
                            <textarea name="answers[@question.Id]" class="form-control" rows="5" placeholder="Write your essay answer here..."></textarea>
                        </div>
                    }
                </div>
            </div>
            qNum++;
        }
    }
    else
    {
        <div class="alert alert-info"><i class="fas fa-info-circle me-2"></i> No questions available for this assignment.</div>
    }

    @if (Model.Questions != null && Model.Questions.Any())
    {
        <div class="d-flex gap-2 mt-4">             <button type="submit" class="btn btn-success btn-lg px-5" onclick="return confirm('Submit your answers? Make sure you have answered all questions.')">
                <i class="fas fa-paper-plane me-2"></i> Submit Answers
            </button>             <a asp-action="MyAssignments" class="btn btn-secondary btn-lg px-4">
                <i class="fas fa-times me-2"></i> Cancel
            </a>
        </div>
    }
</form>
