@model IEnumerable<ExamDto>
@{
    ViewData["Title"] = "My Exams";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="page-title mb-0"><i class="fas fa-file-alt me-2 text-primary"></i>My Exams</h1>
</div>

@if (!Model.Any())
{
    <div class="data-table-wrapper">
        <div class="table-empty-state">
            <i class="fas fa-file-alt fa-2x mb-2 text-muted"></i>
            <p class="mb-0">No exams available yet.</p>
        </div>
    </div>
}
else
{
    <div class="data-table-wrapper">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr><th>Title</th><th>Course</th><th>Date</th><th>Duration</th><th>Status</th><th class="text-end" style="width:180px;">Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td><span class="fw-semibold">@e.Title</span></td>
                            <td><span class="code-badge">@e.CourseId</span></td>
                            <td>@e.StartDateTime.ToString("M/d/yyyy")</td>
                            <td>@e.DurationMinutes min</td>
                            <td>
                                <span class="status-indicator">
                                    <span class="circle @(e.IsPublished ? "success" : "warning")"></span>
                                    @(e.IsPublished ? "Published" : "Draft")
                                </span>
                            </td>
                            <td class="text-end">
                                @if (e.IsPublished)
                                {
                                    <div class="crud-actions justify-content-end">
                                        <a asp-action="TakeExam" asp-route-examId="@e.Id" class="btn btn-sm btn-primary"><i class="fas fa-pen me-1"></i> Take</a>
                                        <a asp-action="ExamResult" asp-route-examId="@e.Id" class="btn btn-sm btn-outline-info"><i class="fas fa-chart-bar"></i> Result</a>
                                    </div>
                                }
                            </td>
                        </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="table-footer-count">
            <span>@Model.Count() exam(s)</span>
        </div>
    </div>
}