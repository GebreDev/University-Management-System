@model ExamResultDto
@{
    ViewData["Title"] = "Exam Result";
}

<h2>Exam Result</h2>

<dl class="row">
    <dt class="col-sm-3">Exam</dt>
    <dd class="col-sm-9">@Model.ExamTitle</dd>
    <dt class="col-sm-3">Total Score</dt>
    <dd class="col-sm-9">@Model.TotalScore</dd>
    <dt class="col-sm-3">Grade</dt>
    <dd class="col-sm-9">@Model.Grade</dd>
    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9"><span class="badge @(Model.IsPass ? "bg-success" : "bg-danger")">@(Model.IsPass ? "Pass" : "Fail")</span></dd>
    <dt class="col-sm-3">Remarks</dt>
    <dd class="col-sm-9">@Model.Remarks</dd>
</dl>