@model ExamDto
@using UniversityManagementSystem.Domain.Enums
@{
    ViewData["Title"] = "Take Exam";
    var startTime = Model.StartDateTime == default ? DateTime.UtcNow : Model.StartDateTime;
    var endTime = startTime.AddMinutes(Model.DurationMinutes > 0 ? Model.DurationMinutes : 60);
    var totalSeconds = (int)(endTime - DateTime.UtcNow).TotalSeconds;
}

@section Styles {
    <style>
        .timer-bar {
            position: sticky;
            top: 0;
            z-index: 1020;
            transition: all 0.3s ease;
        }
        .timer-bar.warning {
            background: #dc3545 !important;
            animation: pulse 1s infinite;
        }
        @@keyframes pulse {
            0% { opacity: 1; }
            50% { opacity: 0.8; }
            100% { opacity: 1; }
        }
        .question-card {
            border-left: 4px solid var(--btn-sky);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .question-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        }
        .question-number {
            width: 36px;
            height: 36px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: var(--btn-sky);
            color: white;
            border-radius: 50%;
            font-weight: bold;
            font-size: 0.9rem;
        }
    </style>
}

<input type="hidden" id="examEndTime" value="@endTime.ToString("o")" />

<!-- Timer Bar -->
<div id="timerBar" class="timer-bar alert alert-warning d-flex justify-content-between align-items-center py-2 mb-3 rounded-3 shadow-sm">
    <div>
        <i class="fas fa-clock me-2"></i>
        <strong>@Model.Title</strong>
        <span class="mx-2">|</span>
        Total Marks: @Model.TotalMarks
    </div>
    <div class="d-flex align-items-center gap-3">
        <span id="countdownTimer" class="badge bg-dark fs-6 px-3 py-2">
            <i class="fas fa-hourglass-half me-1"></i>
            <span id="timerDisplay">Loading...</span>
        </span>
    </div>
</div>

<form asp-action="SubmitExam" method="post" id="examForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="examId" value="@Model.Id" />

    @if (Model.Questions != null && Model.Questions.Any())
    {
        var qNum = 1;
        @foreach (var question in Model.Questions)
        {
            <div class="card question-card shadow-sm mb-3 rounded-3">
                <div class="card-header bg-white py-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="question-number">@qNum</span>
                        <strong class="text-muted ms-2">@question.Marks marks</strong>
                        @if (question.Type == ExamType.MCQ)
                        {
                            <span class="badge bg-success ms-auto">MCQ</span>
                        }
                        else if (question.Type == ExamType.TrueFalse)
                        {
                            <span class="badge bg-info ms-auto">True/False</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark ms-auto">Written</span>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <p class="fs-5 fw-medium mb-3">@question.QuestionText</p>

                    @* Difficulty Level Badge *@
                    @if (!string.IsNullOrEmpty(question.DifficultyLevel))
                    {
                        <div class="mb-2">
                            <span class="badge @(question.DifficultyLevel == "Easy" ? "bg-success" : question.DifficultyLevel == "Medium" ? "bg-warning text-dark" : "bg-danger")">
                                <i class="fas fa-signal me-1"></i> @question.DifficultyLevel
                            </span>
                        </div>
                    }

                    @if (question.Options != null && question.Options.Any())
                    {
                        @foreach (var option in question.Options)
                        {
                            <div class="form-check py-1">
                                <input class="form-check-input" type="radio" name="answers[@question.Id]" value="@option.OptionText" id="q@(question.Id)_opt@(option.Id)" />
                                <label class="form-check-label" for="q@(question.Id)_opt@(option.Id)">@option.OptionText</label>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="mb-2">
                            <textarea name="answers[@question.Id]" class="form-control" rows="3" placeholder="Type your answer..."></textarea>
                        </div>
                    }
                </div>
            </div>
            qNum++;
        }
    }
    else
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i> No questions available for this exam.
        </div>
    }

    <div class="d-flex gap-2 mt-4">         <button type="submit" class="btn btn-success btn-lg px-5" id="submitBtn" onclick="return confirmSubmit()">
            <i class="fas fa-paper-plane me-2"></i> Submit Exam
        </button>         <a asp-action="MyExams" class="btn btn-secondary btn-lg px-4">
            <i class="fas fa-times me-2"></i> Cancel
        </a>
    </div>
</form>

@section Scripts {
    <script>
        const endTime = new Date(document.getElementById('examEndTime').value).getTime();
        const timerDisplay = document.getElementById('timerDisplay');
        const timerBar = document.getElementById('timerBar');
        const examForm = document.getElementById('examForm');

        function updateTimer() {
            const now = new Date().getTime();
            const distance = endTime - now;

            if (distance <= 0) {
                timerDisplay.innerHTML = '<i class="fas fa-times-circle me-1"></i> Time\'s Up!';
                timerBar.className = 'timer-bar alert alert-danger d-flex justify-content-between align-items-center py-2 mb-3 rounded-3 shadow-sm';
                timerBar.classList.add('warning');
                examForm.submit();
                return;
            }

            const hours = Math.floor(distance / (1000 * 60 * 60));
            const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((distance % (1000 * 60)) / 1000);

            timerDisplay.textContent = hours + 'h ' + minutes + 'm ' + seconds + 's';

            if (distance < 300000) { // 5 minutes
                timerBar.className = 'timer-bar alert alert-danger d-flex justify-content-between align-items-center py-2 mb-3 rounded-3 shadow-sm';
                timerBar.classList.add('warning');
                document.getElementById('countdownTimer').className = 'badge bg-danger fs-6 px-3 py-2';
            } else if (distance < 600000) { // 10 minutes
                timerBar.className = 'timer-bar alert alert-warning d-flex justify-content-between align-items-center py-2 mb-3 rounded-3 shadow-sm';
                document.getElementById('countdownTimer').className = 'badge bg-warning text-dark fs-6 px-3 py-2';
            }
        }

        function confirmSubmit() {
            return confirm('Are you sure you want to submit your exam? Make sure you have answered all questions.');
        }

        updateTimer();
        setInterval(updateTimer, 1000);
    </script>
}
