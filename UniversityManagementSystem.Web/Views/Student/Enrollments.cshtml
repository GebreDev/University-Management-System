@model IEnumerable<UniversityManagementSystem.Web.Models.ViewModels.StudentEnrollmentRowViewModel>
@{
    ViewData["Title"] = "My Enrollments";
}

<h1 class="page-title">My Enrollments</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="data-table-wrapper">
        <div class="table-empty-state">
            <i class="fas fa-list-check fa-2x mb-2 text-muted"></i>
            <p class="mb-0">You have no enrollments yet.</p>
            <a asp-action="Dashboard" class="btn-back-pill mt-2"><i class="fas fa-chevron-left"></i> Back</a>
        </div>
    </div>
}
else
{
    <div class="data-table-wrapper">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Course</th>
                        <th>Code</th>
                        <th>Semester</th>
                        <th>Status</th>
                        <th>Enrollment Date</th>
                        <th>Approval Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="fw-semibold">@item.CourseTitle</span></td>
                            <td><span class="code-badge">@item.CourseCode</span></td>
                            <td>@item.SemesterName</td>
                            <td>
                                <span class="status-indicator">
                                    <span class="circle @(item.Status == "Approved" ? "success" : item.Status == "Pending" || item.Status == "Pending Review" ? "warning" : item.Status == "Waitlisted" ? "warning" : "danger")"></span>
                                    @item.Status
                                </span>
                            </td>
                            <td>@item.EnrollmentDate.ToString("M/d/yyyy")</td>
                            <td>@(item.ApprovalDate?.ToString("M/d/yyyy") ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="table-footer-count">
            <span>@Model.Count() enrollment(s)</span>
        </div>
    </div>
}

<a asp-action="Dashboard" class="btn-back-pill">
    <i class="fas fa-chevron-left"></i> Back
</a>