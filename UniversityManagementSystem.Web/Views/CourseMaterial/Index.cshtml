@model IEnumerable<UniversityManagementSystem.Application.DTOs.CourseMaterial.CourseMaterialListDto>
@{
    ViewData["Title"] = "Course Materials";
}

<div class="container-fluid py-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Header: single Upload button instead of the old quick-action cards -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1"><i class="fas fa-folder-open me-2 text-primary"></i>Course Materials</h2>
            <p class="text-muted mb-0">Upload and manage learning resources for your courses.</p>
        </div>
        <a asp-action="Upload" class="btn btn-primary btn-lg">
            <i class="fas fa-cloud-upload-alt me-2"></i> Upload Course Material
        </a>
    </div>

    <!-- Materials table -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Title</th>
                            <th>Course</th>
                            <th>File</th>
                            <th class="text-center">Size</th>
                            <th class="text-center">Downloads</th>
                            <th>Uploaded</th>
                            <th class="text-center" style="width:230px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@item.Title</div>
                                        @if (!string.IsNullOrEmpty(item.Description))
                                        {
                                            <div class="text-muted small text-truncate" style="max-width:280px;" title="@item.Description">@item.Description</div>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@item.CourseCode</span>
                                        <span class="small">@item.CourseTitle</span>
                                    </td>
                                    <td>
                                        <i class="@FileIcon(item.FileType) me-1"></i>
                                        <span class="small text-truncate d-inline-block align-middle" style="max-width:180px;" title="@item.FileName">@item.FileName</span>
                                    </td>
                                    <td class="text-center small">@FormatSize(item.FileSize)</td>
                                    <td class="text-center"><span class="badge bg-secondary">@item.DownloadCount</span></td>
                                    <td class="small text-muted">@item.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td class="text-center">
                                        <div class="d-inline-flex align-items-center gap-1">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm" title="View details">
                                                <i class="fas fa-eye"></i> Details
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm" title="Edit">
                                                <i class="fas fa-edit"></i> Edit
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                                  data-confirm-title="Delete course material?"
                                                  data-confirm-message="Delete @item.Title? This cannot be undone.">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete">
                                                    <i class="fas fa-trash"></i> Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="fas fa-folder-open fa-3x mb-3 d-block"></i>
                                    <h5 class="fw-bold">No course materials yet</h5>
                                    <p class="mb-3">Upload your first material — PDF, DOC/DOCX, PPT/PPTX, XLS/XLSX, TXT, ZIP or images (max 10MB).</p>
                                    <a asp-action="Upload" class="btn btn-primary">
                                        <i class="fas fa-cloud-upload-alt me-1"></i> Upload Course Material
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@functions {
    private static string FileIcon(string fileType) => (fileType ?? "").ToLowerInvariant() switch
    {
        "pdf" => "fas fa-file-pdf text-danger",
        "doc" or "docx" => "fas fa-file-word text-primary",
        "ppt" or "pptx" => "fas fa-file-powerpoint text-danger",
        "xls" or "xlsx" => "fas fa-file-excel text-success",
        "txt" => "fas fa-file-alt text-secondary",
        "zip" => "fas fa-file-archive text-warning",
        "jpg" or "jpeg" or "png" or "gif" => "fas fa-file-image text-info",
        _ => "fas fa-file text-secondary"
    };

    private static string FormatSize(long bytes) => bytes switch
    {
        >= 1024 * 1024 => $"{bytes / 1024.0 / 1024.0:F1} MB",
        >= 1024 => $"{bytes / 1024.0:F0} KB",
        _ => $"{bytes} B"
    };
}
