@model UniversityManagementSystem.Application.DTOs.CourseMaterial.CourseMaterialUploadDto
@{
    ViewData["Title"] = "Upload Course Material";
    var courses = ViewBag.Courses as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-cloud-upload-alt me-2 text-primary"></i>Upload Course Material</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Upload" method="post" enctype="multipart/form-data" id="uploadForm">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="All" class="text-danger mb-3 small"></div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Course <span class="text-danger">*</span></label>
                            <select asp-for="CourseId" class="form-select" required>
                                <option value="">-- Select a course --</option>
                                @foreach (var c in courses)
                                {
                                    <option value="@c.Value">@c.Text</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Title <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control" placeholder="e.g. Week 1 — Introduction to Data Structures" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3"
                                      placeholder="Optional summary students will see with the file..."></textarea>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">File <span class="text-danger">*</span></label>
                            <input asp-for="File" type="file" class="form-control" id="materialFile"
                                   accept=".pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.txt,.zip,.jpg,.jpeg,.png,.gif" required />
                            <div class="form-text">
                                <i class="fas fa-info-circle me-1"></i>
                                Allowed: PDF, DOC, DOCX, PPT, PPTX, XLS, XLSX, TXT, ZIP, JPG, PNG, GIF — max 10MB.
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary" id="uploadBtn">
                                <i class="fas fa-cloud-upload-alt me-1"></i> Upload
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('uploadForm');
            var btn = document.getElementById('uploadBtn');
            if (form && btn) {
                form.addEventListener('submit', function () {
                    btn.disabled = true;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Uploading...';
                });
            }
        })();
    </script>
}
