@model IEnumerable<UniversityManagementSystem.Application.DTOs.CourseMaterial.CourseMaterialListDto>
@{
    ViewData["Title"] = "My Course Materials";
}

<div class="container-fluid py-4">

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="mb-4">
        <h2 class="fw-bold mb-1"><i class="fas fa-folder-open me-2 text-primary"></i>My Course Materials</h2>
        <p class="text-muted mb-0">Files and resources uploaded by your instructors.</p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Title</th>
                            <th>Course</th>
                            <th>File</th>
                            <th class="text-center">Size</th>
                            <th>Uploaded</th>
                            <th class="text-center" style="width:140px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@item.Title</div>
                                        @if (!string.IsNullOrEmpty(item.Description))
                                        {
                                            <div class="text-muted small text-truncate" style="max-width:280px;" title="@item.Description">@item.Description</div>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@item.CourseCode</span>
                                        <span class="small">@item.CourseTitle</span>
                                    </td>
                                    <td>
                                        <i class="@FileIcon(item.FileType) me-1"></i>
                                        <span class="small text-truncate d-inline-block align-middle" style="max-width:180px;" title="@item.FileName">@item.FileName</span>
                                    </td>
                                    <td class="text-center small">@FormatSize(item.FileSize)</td>
                                    <td class="small text-muted">
                                        @item.CreatedAt.ToString("MMM dd, yyyy")
                                        @if (!string.IsNullOrEmpty(item.UploadedByName))
                                        {
                                            <div class="text-muted" style="font-size:.75rem;">by @item.UploadedByName</div>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Download" asp-route-id="@item.Id" class="btn btn-success btn-sm" title="Download @item.FileName">
                                            <i class="fas fa-download me-1"></i> Download
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="fas fa-folder-open fa-3x mb-3 d-block"></i>
                                    <h5 class="fw-bold">No materials available yet</h5>
                                    <p class="mb-0">Materials uploaded by your instructors for your enrolled courses will appear here.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@functions {
    private static string FileIcon(string fileType) => (fileType ?? "").ToLowerInvariant() switch
    {
        "pdf" => "fas fa-file-pdf text-danger",
        "doc" or "docx" => "fas fa-file-word text-primary",
        "ppt" or "pptx" => "fas fa-file-powerpoint text-danger",
        "xls" or "xlsx" => "fas fa-file-excel text-success",
        "txt" => "fas fa-file-alt text-secondary",
        "zip" => "fas fa-file-archive text-warning",
        "jpg" or "jpeg" or "png" or "gif" => "fas fa-file-image text-info",
        _ => "fas fa-file text-secondary"
    };

    private static string FormatSize(long bytes) => bytes switch
    {
        >= 1024 * 1024 => $"{bytes / 1024.0 / 1024.0:F1} MB",
        >= 1024 => $"{bytes / 1024.0:F0} KB",
        _ => $"{bytes} B"
    };
}
