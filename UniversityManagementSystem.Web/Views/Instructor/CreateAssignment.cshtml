@model AssignmentCreateDto
@{
    ViewData["Title"] = "Create Assignment";
}

<h2><i class="fas fa-plus-circle me-2"></i> Create New Assignment</h2>

<div class="card shadow">
    <div class="card-body">
        <form asp-action="CreateAssignment" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="row">
                <div class="col-md-8">
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">Title</label>
                        <input asp-for="Title" class="form-control" required />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label asp-for="CourseId" class="form-label">Course</label>
                        <select asp-for="CourseId" class="form-select" asp-items="@(new SelectList(ViewBag.Courses ?? new List<object>(), "Id", "Title"))">
                            <option value="">-- Select Course --</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="4" required></textarea>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <div class="mb-3">
                        <label asp-for="Deadline" class="form-label">Deadline</label>
                        <input asp-for="Deadline" class="form-control" type="datetime-local" required />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label asp-for="TotalMarks" class="form-label">Total Marks</label>
                        <input asp-for="TotalMarks" class="form-control" type="number" min="1" required />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label asp-for="LateSubmissionPenalty" class="form-label">Late Penalty (%)</label>
                        <input asp-for="LateSubmissionPenalty" class="form-control" type="number" min="0" max="100" placeholder="e.g. 10" />
                        <small class="text-muted">Percentage deducted for late submission</small>
                    </div>
                </div>
            </div>
            <div class="mb-3">
                <div class="form-check form-switch">
                    <input asp-for="AllowLateSubmission" class="form-check-input" role="switch" id="allowLate" />
                    <label class="form-check-label" for="allowLate">Allow Late Submissions</label>
                    <small class="d-block text-muted">If enabled, students can submit after the deadline with the penalty applied</small>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Attachment (optional)</label>
                <input type="file" asp-for="Attachment" class="form-control" accept=".pdf,.docx,.xlsx,.csv,.txt,.zip" />
            </div>
            <button type="submit" class="btn btn-success"><i class="fas fa-save"></i> Create Assignment</button>
            <a asp-action="Assignments" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
