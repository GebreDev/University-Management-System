@model IEnumerable<SubmissionDto>
@{
    ViewData["Title"] = "View Submissions";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><i class="fas fa-inbox me-2 text-primary"></i>Assignment Submissions</h2>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No submissions received yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Student</th>
                    <th>Submitted At</th>
                    <th>Status</th>
                    <th>Grade</th>
                    <th>Feedback</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.StudentName</td>
                        <td>@item.SubmittedAt.ToString("MMM dd, yyyy HH:mm")</td>
                        <td>
                            <span class="badge @(item.IsGraded ? "bg-success" : "bg-warning")">
                                @(item.IsGraded ? "Graded" : "Pending")
                            </span>
                        </td>
                        <td>@(item.Grade?.ToString() ?? "—")</td>
                        <td>@(item.Feedback ?? "—")</td>
                        <td class="text-end">
                            <div class="crud-actions justify-content-end">
                                <a asp-action="GradeSubmission" asp-route-submissionId="@item.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-check me-1"></i>Grade
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<a asp-action="Assignments" class="btn-back-pill"><i class="fas fa-chevron-left"></i> Back</a>
