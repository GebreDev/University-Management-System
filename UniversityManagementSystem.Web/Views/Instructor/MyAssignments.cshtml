@model IEnumerable<UniversityManagementSystem.Web.Models.ViewModels.InstructorCourseAssignmentViewModel>
@{
    ViewData["Title"] = "My Course Assignments";
    var items = Model.ToList();
    var totalStudents = items.Sum(i => i.EnrollmentCount);
    var totalCredits = items.Sum(i => i.Credits);
    var totalAssignments = items.Sum(i => i.AssignmentCount);
    var totalExams = items.Sum(i => i.ExamCount);
}

<style>
    .my-assignments-page { padding: 10px 0 40px; }

    .assignments-header {
        background: linear-gradient(135deg, #1a5276, #2e86c1);
        color: white;
        border-radius: 20px;
        padding: 32px 36px;
        margin-bottom: 28px;
        box-shadow: 0 10px 30px rgba(26,82,118,.18);
        position: relative;
        overflow: hidden;
    }
    .assignments-header::after {
        content: "📚";
        position: absolute;
        right: 30px;
        top: -10px;
        font-size: 90px;
        opacity: .08;
        transform: rotate(-10deg);
    }
    .assignments-header h1 {
        font-size: 1.6rem;
        font-weight: 700;
        margin-bottom: 6px;
    }
    .assignments-header p {
        opacity: .85;
        margin: 0;
        font-size: .95rem;
    }

    .stat-row { margin-bottom: 24px; }
    .stat-card {
        background: white;
        border: 1px solid #e8eef3;
        border-radius: 16px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 16px;
        transition: transform .2s, box-shadow .2s;
    }
    .stat-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 24px rgba(0,0,0,.07);
    }
    .stat-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
    }
    .stat-icon.courses  { background: #eaf2fb; color: #2e86c1; }
    .stat-icon.students { background: #e8f8f0; color: #1a9854; }
    .stat-icon.credits  { background: #fdf2e9; color: #d68910; }
    .stat-icon.work     { background: #f4ecf7; color: #8e44ad; }
    .stat-body .stat-label {
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .4px;
        color: #7f8c8d;
        font-weight: 600;
    }
    .stat-body .stat-value {
        font-size: 1.5rem;
        font-weight: 700;
        color: #2c3e50;
        line-height: 1.2;
    }

    .section-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .section-title i { color: #2e86c1; }

    .course-assignment-card {
        background: white;
        border: 1px solid #e8eef3;
        border-radius: 18px;
        overflow: hidden;
        transition: transform .2s, box-shadow .25s;
        height: 100%;
        display: flex;
        flex-direction: column;
    }
    .course-assignment-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 32px rgba(0,0,0,.08);
    }

    .card-accent {
        height: 5px;
        width: 100%;
    }
    .card-accent.cs    { background: linear-gradient(90deg, #2e86c1, #5dade2); }
    .card-accent.math  { background: linear-gradient(90deg, #d68910, #f0b27a); }
    .card-accent.phy   { background: linear-gradient(90deg, #8e44ad, #bb8fce); }
    .card-accent.gen   { background: linear-gradient(90deg, #1a9854, #58d68d); }

    .card-body-inner {
        padding: 22px 24px;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .card-top-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        margin-bottom: 12px;
    }
    .course-code-badge {
        font-size: .72rem;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 8px;
        background: #eaf2fb;
        color: #2e86c1;
        letter-spacing: .3px;
    }
    .enrollment-badge {
        font-size: .72rem;
        font-weight: 600;
        padding: 4px 10px;
        border-radius: 8px;
        background: #e8f8f0;
        color: #1a9854;
    }

    .card-course-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 4px;
        line-height: 1.3;
    }
    .card-dept {
        font-size: .82rem;
        color: #7f8c8d;
        margin-bottom: 14px;
    }

    .card-meta-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-bottom: 16px;
        /* Hidden until the card is hovered; space is kept so cards don't jump */
        opacity: 0;
        transform: translateY(4px);
        transition: opacity .25s ease, transform .25s ease;
    }
    .course-assignment-card:hover .card-meta-grid,
    .course-assignment-card:focus-within .card-meta-grid {
        opacity: 1;
        transform: translateY(0);
    }
    /* Devices that can't hover (touch): always show the meta info */
    @@media (hover: none) {
        .card-meta-grid {
            opacity: 1;
            transform: none;
        }
    }
    .meta-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: .8rem;
        color: #5d6d7e;
    }
    .meta-item i {
        font-size: .75rem;
        width: 18px;
        text-align: center;
        color: #2e86c1;
    }
    .meta-item strong {
        color: #2c3e50;
    }

    .card-actions {
        margin-top: auto;
        padding-top: 14px;
        border-top: 1px solid #f0f4f7;
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }
    .card-actions .btn {
        font-size: .75rem;
        font-weight: 600;
        border-radius: 8px;
        padding: 5px 10px;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        background: white;
        border: 1px solid #e8eef3;
        border-radius: 18px;
    }
    .empty-state i {
        font-size: 3rem;
        color: #d5d8dc;
        margin-bottom: 16px;
    }
    .empty-state h5 { color: #5d6d7e; }
    .empty-state p { color: #95a5a6; font-size: .9rem; }

    @@media (max-width: 768px) {
        .assignments-header { padding: 24px 20px; }
        .assignments-header h1 { font-size: 1.3rem; }
        .card-body-inner { padding: 18px 16px; }
    }
</style>

<div class="my-assignments-page">

    <!-- Header -->
    <div class="assignments-header">
        <div class="d-flex align-items-center gap-3">
            <div style="width:56px;height:56px;border-radius:16px;background:rgba(255,255,255,.15);display:flex;align-items:center;justify-content:center;font-size:26px;flex-shrink:0;">
                <i class="fas fa-chalkboard-teacher"></i>
            </div>
            <div>
                <h1 class="mb-1">My Course Assignments</h1>
                <p class="mb-0">Courses and subjects assigned to you — manage your teaching portfolio.</p>
            </div>
        </div>
    </div>

    <!-- Metric Cards -->
    <div class="row g-3 stat-row">
        <div class="col-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon courses"><i class="fas fa-book-open"></i></div>
                <div class="stat-body">
                    <div class="stat-label">Courses</div>
                    <div class="stat-value">@items.Count</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon students"><i class="fas fa-user-graduate"></i></div>
                <div class="stat-body">
                    <div class="stat-label">Students</div>
                    <div class="stat-value">@totalStudents.ToString("N0")</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon credits"><i class="fas fa-layer-group"></i></div>
                <div class="stat-body">
                    <div class="stat-label">Credits</div>
                    <div class="stat-value">@totalCredits</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon work"><i class="fas fa-tasks"></i></div>
                <div class="stat-body">
                    <div class="stat-label">Assignments</div>
                    <div class="stat-value">@totalAssignments</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Course Assignment Cards -->
    <div class="section-title">
        <i class="fas fa-th-large"></i>
        Course Assignments
    </div>

    @if (!items.Any())
    {
        <div class="empty-state">
            <i class="fas fa-book-open d-block"></i>
            <h5>No Course Assignments Found</h5>
            <p>You have not been assigned to any courses yet. Contact an administrator to assign courses to your profile.</p>
            <a asp-action="Dashboard" class="btn-back-pill mt-2">
                <i class="fas fa-chevron-left"></i> Back
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in items)
            {
                var accentClass = item.CourseCode.StartsWith("CS") ? "cs"
                                : item.CourseCode.StartsWith("MATH") ? "math"
                                : item.CourseCode.StartsWith("PHY") ? "phy"
                                : "gen";
                <div class="col-lg-4 col-md-6">
                    <div class="course-assignment-card">
                        <div class="card-accent @accentClass"></div>
                        <div class="card-body-inner">

                            <!-- Top Row: Code + Enrollment -->
                            <div class="card-top-row">
                                <span class="course-code-badge">@item.CourseCode</span>
                                <span class="enrollment-badge">
                                    <i class="fas fa-user-graduate me-1"></i>@item.EnrollmentCount students
                                </span>
                            </div>

                            <!-- Course Title + Department -->
                            <div class="card-course-title">@item.CourseTitle</div>
                            <div class="card-dept">
                                <i class="fas fa-building me-1"></i>@item.DepartmentName
                            </div>

                            <!-- Meta Grid -->
                            <div class="card-meta-grid">
                                <div class="meta-item">
                                    <i class="fas fa-star"></i>
                                    <span><strong>@item.Credits</strong> Credits</span>
                                </div>
                                <div class="meta-item">
                                    <i class="fas fa-tasks"></i>
                                    <span><strong>@item.AssignmentCount</strong> Assignments</span>
                                </div>
                                <div class="meta-item">
                                    <i class="fas fa-file-alt"></i>
                                    <span><strong>@item.ExamCount</strong> Exams</span>
                                </div>
                                <div class="meta-item">
                                    <i class="fas fa-calendar"></i>
                                    <span>@item.StartDate.ToString("MMM yyyy") – @item.EndDate.ToString("MMM yyyy")</span>
                                </div>
                            </div>

                            <!-- Actions -->
                            <div class="card-actions">
                                <a asp-action="CourseClass" asp-route-courseId="@item.CourseId" class="btn btn-primary w-100">
                                    <i class="fas fa-door-open me-1"></i> Manage Course
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Back -->
    <div class="mt-4">
        <a asp-action="Dashboard" class="btn-back-pill">
            <i class="fas fa-chevron-left"></i> Back
        </a>
    </div>

</div>
