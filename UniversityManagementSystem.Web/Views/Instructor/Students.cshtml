@model IEnumerable<EnrollmentListDto>
@{
    ViewData["Title"] = "Students in Course";
    var items = Model.ToList();
    var courseId = ViewBag.CourseId as int? ?? items.FirstOrDefault()?.CourseId ?? 0;
}

<div class="dash-page">

    <!-- Header -->
    <div class="dash-head">
        <div>
            <h1 class="dash-greeting"><i class="fas fa-user-graduate me-2 text-primary"></i>Students in Course</h1>
            <p class="dash-subtitle">Approved enrollments for this course.</p>
        </div>
        <div class="dash-date">
            <strong>@items.Count students</strong>
            <span>approved enrollments</span>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4">
            <div class="metric-card">
                <div class="metric-icon stat-grad-a"><i class="fas fa-user-graduate"></i></div>
                <div class="metric-body">
                    <div class="metric-label">Students</div>
                    <span class="metric-value">@items.Count</span>
                    <div class="metric-footer"><span class="metric-sub">in this course</span></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="metric-card">
                <div class="metric-icon stat-grad-c"><i class="fas fa-check-circle"></i></div>
                <div class="metric-body">
                    <div class="metric-label">Status</div>
                    <span class="metric-value">Approved</span>
                    <div class="metric-footer"><span class="metric-sub">active seats</span></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="metric-card">
                <div class="metric-icon stat-grad-b"><i class="fas fa-calendar-check"></i></div>
                <div class="metric-body">
                    <div class="metric-label">Attendance</div>
                    <span class="metric-value"><i class="fas fa-arrow-right me-1 opacity-50"></i></span>
                    <div class="metric-footer">
                        <a asp-action="MarkAttendance" asp-route-courseId="@courseId" class="dash-link">Mark now →</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (!items.Any())
    {
        <div class="list-card text-center py-5">
            <i class="fas fa-users fa-4x text-muted mb-3 opacity-50"></i>
            <h5 class="text-muted">No Students Enrolled</h5>
            <p class="text-muted mb-3">There are no approved enrollments for this course yet.</p>
            <a asp-action="MyStudents" class="btn btn-primary">
                <i class="fas fa-user-graduate me-1"></i> View All My Students
            </a>
        </div>
    }
    else
    {
        <div class="data-table-wrapper">
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Student</th>
                            <th>Student ID</th>
                            <th>Status</th>
                            <th>Enrolled</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < items.Count; i++)
                        {
                            var item = items[i];
                            <tr>
                                <td><span class="fw-semibold">@item.StudentFullName</span></td>
                                <td><span class="code-badge">@item.StudentId</span></td>
                                <td>
                                    <span class="status-indicator"><span class="circle success"></span>@item.Status</span>
                                </td>
                                <td><small class="text-muted">@item.EnrollmentDate.ToString("M/d/yyyy")</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="table-footer-count">
                <span>@items.Count students</span>
            </div>
        </div>

        <div class="mt-3">
            <a asp-action="MyStudents" class="btn btn-outline-primary">
                <i class="fas fa-users me-1"></i> View All My Students
            </a>
            <a asp-action="Courses" class="btn-back-pill">
                <i class="fas fa-chevron-left"></i> Back
            </a>
        </div>
    }
</div>
