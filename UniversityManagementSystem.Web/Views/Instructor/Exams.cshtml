@model IEnumerable<ExamDto>
@{
    ViewData["Title"] = "Manage Exams";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h2 class="fw-bold"><i class="fas fa-file-alt me-2"></i> Manage Exams</h2>
    <a asp-action="CreateExam" class="btn btn-success"><i class="fas fa-plus me-1"></i> Create New</a>
</div>

<!-- Search -->
<div class="row mb-3">
    <div class="col-md-6">
        <div class="input-group">
            <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
            <input type="text" id="searchInput" class="form-control" placeholder="Search by title, type, or date..." />
        </div>
    </div>
    <div class="col-md-2">
        <select id="statusFilter" class="form-select">
            <option value="all">All Status</option>
            <option value="published">Published</option>
            <option value="draft">Draft</option>
        </select>
    </div>
    <div class="col-md-2">
        <select id="typeFilter" class="form-select">
            <option value="all">All Types</option>
            <option value="Midterm">Midterm</option>
            <option value="Final">Final</option>
            <option value="Quiz">Quiz</option>
            <option value="Assignment">Assignment</option>
        </select>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info shadow-sm rounded-3">
        <i class="fas fa-info-circle me-2"></i> No exams found. Create your first exam!
    </div>
}
else
{
    <div class="data-table-wrapper">
        <div class="table-responsive">
            <table class="table" id="examsTable">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Type</th>
                        <th>Start Date</th>
                        <th>Duration</th>
                        <th>Marks</th>
                        <th>Status</th>
                        <th style="width:280px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="fw-semibold">@item.Title</span></td>
                            <td><span class="code-badge">@item.Type</span></td>
                            <td>
                                <strong>@item.StartDateTime.ToString("MMM dd, yyyy")</strong>
                                <small class="d-block text-muted">@item.StartDateTime.ToString("HH:mm")</small>
                            </td>
                            <td>@item.DurationMinutes min</td>
                            <td>@item.TotalMarks</td>
                            <td>
                                <span class="status-indicator">
                                    <span class="circle @(item.IsPublished ? "success" : "secondary")"></span>
                                    @(item.IsPublished ? "Published" : "Draft")
                                </span>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="EditExam" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm" title="Edit"><i class="fas fa-pen-to-square"></i></a>
                                    <a asp-action="ManageQuestions" asp-route-examId="@item.Id" class="btn btn-outline-success btn-sm" title="Manage Questions"><i class="fas fa-list-check"></i></a>
                                    @if (!item.IsPublished)
                                    {
                                        <form asp-action="PublishExam" method="post" class="ms-1">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-success" title="Publish"><i class="fas fa-globe me-1"></i>Post</button>
                                        </form>
                                    }
                                    <a asp-action="GradeExam" asp-route-examId="@item.Id" class="btn btn-outline-info btn-sm" title="Grade"><i class="fas fa-check-double"></i></a>
                                    <form asp-action="DeleteExam" method="post" class="ms-1"
                                          data-confirm-title="Delete exam?"
                                          data-confirm-message="Are you sure you want to delete this exam? This action cannot be undone.">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"><i class="fas fa-trash-can"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="table-footer-count">
            <span>Showing <span id="visibleCount">@Model.Count()</span> exams</span>
        </div>
    </div>
}

<a asp-action="Dashboard" class="btn-back-pill mt-2">
    <i class="fas fa-chevron-left"></i> Back
</a>

@section Scripts {
    <script>
        $(document).ready(function() {
            function filterTable() {
                var search = $('#searchInput').val().toLowerCase();
                var status = $('#statusFilter').val();
                var type = $('#typeFilter').val();
                var visible = 0;
                
                $('#examsTable tbody tr').each(function() {
                    var text = $(this).text().toLowerCase();
                    var rowStatus = $(this).find('.status-indicator').first().text().trim();
                    var rowType = $(this).find('.code-badge').first().text().trim();
                    var isPublished = rowStatus.indexOf('Published') !== -1;
                    var show = true;
                    
                    if (search && !text.includes(search)) show = false;
                    if (status === 'published' && !isPublished) show = false;
                    if (status === 'draft' && isPublished) show = false;
                    if (type !== 'all' && rowType !== type) show = false;
                    
                    $(this).toggle(show);
                    if (show) visible++;
                });
                
                $('#visibleCount').text(visible);
            }
            
            $('#searchInput').on('keyup', filterTable);
            $('#statusFilter').on('change', filterTable);
            $('#typeFilter').on('change', filterTable);
        });
    </script>
}
