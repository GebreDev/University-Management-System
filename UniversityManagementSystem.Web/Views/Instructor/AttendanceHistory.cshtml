@model IEnumerable<UniversityManagementSystem.Application.DTOs.Attendance.AttendanceListDto>
@using UniversityManagementSystem.Domain.Enums
@{
    ViewData["Title"] = "Attendance History";
    var courseName = ViewBag.CourseName as string ?? "Course";
    var courses = ViewBag.Courses as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var currentCourseId = ViewBag.CourseId as int? ?? 0;
    var selectedDate = ViewBag.SelectedDate as DateTime?;
}

<style>
    .history-header {
        background: linear-gradient(135deg, #4a90e2 0%, #1e5aa8 100%);
        border-radius: 16px;
        padding: 24px 32px;
        color: white;
        margin-bottom: 24px;
    }
    .history-header h2 { margin: 0; font-weight: 700; }
    .history-header .subtitle { opacity: 0.85; font-size: 0.9rem; }
    .record-card {
        transition: all 0.2s ease;
        border-left: 4px solid transparent;
        border-radius: 12px;
    }
    .record-card:hover {
        box-shadow: 0 4px 16px rgba(0,0,0,0.08);
        transform: translateY(-2px);
    }
    .record-card.present { border-left-color: #198754; }
    .record-card.absent { border-left-color: #dc3545; }
    .record-card.late { border-left-color: #ffc107; }
    .record-card.excused { border-left-color: #0dcaf0; }
    .date-group-header {
        font-weight: 700;
        font-size: 1.05rem;
        padding: 8px 0;
        border-bottom: 2px solid #e9ecef;
        margin-bottom: 12px;
    }
    .stats-card-today {
        transition: transform 0.2s ease;
    }
    .stats-card-today:hover {
        transform: translateY(-4px);
    }
    .student-avatar-sm {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--btn-sky), var(--btn-sky-deep));
        color: white;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 0.75rem;
        flex-shrink: 0;
    }
</style>

<div class="history-header">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h2><i class="fas fa-history me-2"></i> Attendance History</h2>
            <div class="subtitle">
                <i class="fas fa-book-open me-1"></i> <strong>@courseName</strong>
                <span class="mx-2">|</span>
                <i class="fas fa-list me-1"></i> <span>@Model.Count() record(s)</span>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="MarkAttendance" asp-route-courseId="@currentCourseId" class="btn btn-light">
                <i class="fas fa-plus me-1"></i> Mark Attendance
            </a>
            <a asp-action="Dashboard" class="btn-back-pill">
                <i class="fas fa-chevron-left"></i> Back
            </a>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm" role="alert">
        <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Filters -->
<div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-body p-4">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-semibold">
                    <i class="fas fa-book me-1 text-primary"></i> Course
                </label>
                <select id="courseFilter" class="form-select">
                    @foreach (var c in courses)
                    {
                        var cId = (int)c.Id;
                        if (cId == currentCourseId)
                        {
                            <option value="@cId" selected>@c.Title</option>
                        }
                        else
                        {
                            <option value="@cId">@c.Title</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold">
                    <i class="fas fa-calendar me-1 text-primary"></i> Filter by Date
                </label>
                <input type="date" id="dateFilter" class="form-control" value="@(selectedDate?.ToString("yyyy-MM-dd") ?? "")" />
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button id="applyFilter" class="btn btn-primary">
                    <i class="fas fa-filter me-1"></i> Apply
                </button>
                <button id="clearFilter" class="btn btn-outline-secondary">
                    <i class="fas fa-undo me-1"></i> Clear
                </button>
            </div>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body text-center py-5">
            <i class="fas fa-calendar-times fa-4x text-muted mb-3 opacity-50"></i>
            <h5 class="text-muted">No Attendance Records</h5>
            <p class="text-muted mb-3">No attendance records found for this @(selectedDate.HasValue ? "date" : "course").</p>
            <a asp-action="MarkAttendance" asp-route-courseId="@currentCourseId" class="btn btn-success">
                <i class="fas fa-plus me-1"></i> Mark Attendance Now
            </a>
        </div>
    </div>
}
else
{
    <!-- Summary Stats -->
    var total = Model.Count();
    var presentCount = Model.Count(a => a.Status == AttendanceStatus.Present);
    var absentCount = Model.Count(a => a.Status == AttendanceStatus.Absent);
    var lateCount = Model.Count(a => a.Status == AttendanceStatus.Late);
    var excusedCount = Model.Count(a => a.Status == AttendanceStatus.Excused);
    var percentage = total > 0 ? (double)presentCount / total * 100 : 0;

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4 stats-card-today stat-grad-b">
                <div class="text-white">
                    <i class="fas fa-check-circle fa-2x mb-2"></i>
                    <h3 class="fw-bold mb-0">@presentCount</h3>
                    <small>Present</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4 stats-card-today stat-grad-c">
                <div class="text-white">
                    <i class="fas fa-times-circle fa-2x mb-2"></i>
                    <h3 class="fw-bold mb-0">@absentCount</h3>
                    <small>Absent</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4 stats-card-today stat-grad-e">
                <div class="text-white">
                    <i class="fas fa-clock fa-2x mb-2"></i>
                    <h3 class="fw-bold mb-0">@lateCount</h3>
                    <small>Late</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4 stats-card-today stat-grad-a">
                <div class="text-white">
                    <i class="fas fa-chart-line fa-2x mb-2"></i>
                    <h3 class="fw-bold mb-0">@percentage.ToString("F0")%</h3>
                    <small>Rate</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Group by Date -->
    var groupedByDate = Model.GroupBy(a => a.Date.Date).OrderByDescending(g => g.Key);

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Date</th>
                            <th>Student</th>
                            <th>Status</th>
                            <th>Remarks</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var group in groupedByDate)
                        {
                            var rowCount = group.Count();
                            var dateStr = group.Key.ToString("ddd, MMM dd yyyy");
                            @foreach (var item in group)
                            {
                                <tr class="record-card @item.Status.ToString().ToLower()">
                                    <td>
                                        <strong>@item.Date.ToString("MMM dd")</strong>
                                        <small class="d-block text-muted">@item.Date.ToString("ddd")</small>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="student-avatar-sm">
                                                @(item.StudentName?.Substring(0, 1) ?? "?")
                                            </div>
                                            <div>
                                                <strong>@item.StudentName</strong>
                                                <small class="d-block text-muted">@item.CourseName</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (item.Status == AttendanceStatus.Present)
                                        {
                                            <span class="badge bg-success rounded-pill px-3 py-2">
                                                <i class="fas fa-check me-1"></i> Present
                                            </span>
                                        }
                                        else if (item.Status == AttendanceStatus.Absent)
                                        {
                                            <span class="badge bg-danger rounded-pill px-3 py-2">
                                                <i class="fas fa-times me-1"></i> Absent
                                            </span>
                                        }
                                        else if (item.Status == AttendanceStatus.Late)
                                        {
                                            <span class="badge bg-warning text-dark rounded-pill px-3 py-2">
                                                <i class="fas fa-clock me-1"></i> Late
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info rounded-pill px-3 py-2">
                                                <i class="fas fa-check-double me-1"></i> Excused
                                            </span>
                                        }
                                    </td>
                                    <td><small>@(item.Remarks ?? "-")</small></td>
                                    <td>                                         <a asp-action="EditAttendance" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-edit me-1"></i> Edit
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            // Course filter
            $('#courseFilter').on('change', function() {
                var courseId = $(this).val();
                var date = $('#dateFilter').val();
                var url = '@Url.Action("AttendanceHistory", "Instructor")?courseId=' + courseId;
                if (date) url += '&date=' + date;
                window.location.href = url;
            });

            // Date filter
            $('#applyFilter').on('click', function() {
                var courseId = $('#courseFilter').val();
                var date = $('#dateFilter').val();
                var url = '@Url.Action("AttendanceHistory", "Instructor")?courseId=' + courseId;
                if (date) url += '&date=' + date;
                window.location.href = url;
            });

            $('#clearFilter').on('click', function() {
                var courseId = $('#courseFilter').val();
                window.location.href = '@Url.Action("AttendanceHistory", "Instructor")?courseId=' + courseId;
            });
        });
    </script>
}
