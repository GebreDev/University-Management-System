@model Zone
@{
    ViewData["Title"] = "Delete Zone";
}

<h2><i class="fas fa-trash me-2 text-danger"></i>Delete Zone</h2>

<div class="alert alert-warning">
    <i class="fas fa-exclamation-triangle me-2"></i>Are you sure you want to delete this zone? This action cannot be undone.
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>
            <dt class="col-sm-3">Region</dt>
            <dd class="col-sm-9"><span class="badge bg-primary">@Model.Region?.Name</span></dd>
            <dt class="col-sm-3">Woredas</dt>
            <dd class="col-sm-9"><span class="badge bg-info">@Model.Woredas.Count</span></dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <form asp-action="DeleteZone" method="post" class="d-inline">
        <input type="hidden" name="id" value="@Model.ZoneId" />
        <button type="submit" class="btn btn-danger">
            <i class="fas fa-trash me-1"></i> Delete
        </button>
    </form>
    <a asp-action="Zones" class="btn btn-secondary">Cancel</a>
</div>
