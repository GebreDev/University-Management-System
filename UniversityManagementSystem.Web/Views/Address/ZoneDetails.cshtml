@model Zone
@{
    ViewData["Title"] = "Zone Details";
}

<h2><i class="fas fa-map me-2 text-success"></i>@Model.Name</h2>

<div class="card border-0 shadow-sm mt-3 mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Zone ID</dt>
            <dd class="col-sm-9">@Model.ZoneId</dd>
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>
            <dt class="col-sm-3">Region</dt>
            <dd class="col-sm-9"><span class="badge bg-primary">@Model.Region?.Name</span></dd>
            <dt class="col-sm-3">Total Woredas</dt>
            <dd class="col-sm-9"><span class="badge bg-info">@Model.Woredas.Count</span></dd>
        </dl>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4><i class="fas fa-city me-2 text-warning"></i>Woredas in @Model.Name</h4>
    <a asp-action="CreateWoreda" asp-route-zoneId="@Model.ZoneId" class="btn btn-sm btn-warning">
        <i class="fas fa-plus me-1"></i> Add Woreda
    </a>
</div>

@if (Model.Woredas.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Kebeles</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @{ var idx = 0; }
                @foreach (var woreda in Model.Woredas.OrderBy(w => w.Name))
                {
                    idx++;
                    <tr>
                        <td>@idx</td>
                        <td>@woreda.Name</td>
                        <td><span class="badge bg-secondary">@woreda.Kebeles.Count</span></td>
                        <td class="text-end">
                            <a asp-action="WoredaDetails" asp-route-id="@woreda.WoredaId" class="btn btn-sm btn-outline-info"><i class="fas fa-eye me-1"></i>Details</a>
                            <a asp-action="EditWoreda" asp-route-id="@woreda.WoredaId" class="btn btn-sm btn-outline-warning"><i class="fas fa-edit me-1"></i>Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="text-center text-muted py-4">
        <i class="fas fa-inbox fa-2x mb-2"></i>
        <p>No woredas found in this zone.</p>
    </div>
}

<a asp-action="Zones" class="btn-back-pill"><i class="fas fa-chevron-left"></i> Back</a>
