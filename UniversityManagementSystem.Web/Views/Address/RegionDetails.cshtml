@model Region
@{
    ViewData["Title"] = "Region Details";
}

<h2><i class="fas fa-globe-africa me-2 text-primary"></i>@Model.Name</h2>

<div class="card border-0 shadow-sm mt-3 mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Region ID</dt>
            <dd class="col-sm-9">@Model.RegionId</dd>
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>
            <dt class="col-sm-3">Total Zones</dt>
            <dd class="col-sm-9"><span class="badge bg-info">@Model.Zones.Count</span></dd>
        </dl>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4><i class="fas fa-map me-2 text-success"></i>Zones in @Model.Name</h4>
    <a asp-action="CreateZone" asp-route-regionId="@Model.RegionId" class="btn btn-sm btn-success">
        <i class="fas fa-plus me-1"></i> Add Zone
    </a>
</div>

@if (Model.Zones.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Woredas</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @{ var idx = 0; }
                @foreach (var zone in Model.Zones.OrderBy(z => z.Name))
                {
                    idx++;
                    <tr>
                        <td>@idx</td>
                        <td>@zone.Name</td>
                        <td><span class="badge bg-secondary">@zone.Woredas.Count</span></td>
                        <td class="text-end">
                            <a asp-action="ZoneDetails" asp-route-id="@zone.ZoneId" class="btn btn-sm btn-outline-info"><i class="fas fa-eye me-1"></i>Details</a>
                            <a asp-action="EditZone" asp-route-id="@zone.ZoneId" class="btn btn-sm btn-outline-warning"><i class="fas fa-edit me-1"></i>Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="text-center text-muted py-4">
        <i class="fas fa-inbox fa-2x mb-2"></i>
        <p>No zones found in this region.</p>
    </div>
}

<a asp-action="Regions" class="btn-back-pill"><i class="fas fa-chevron-left"></i> Back</a>
