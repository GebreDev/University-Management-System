@model IEnumerable<Zone>
@{
    ViewData["Title"] = "Zones";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><i class="fas fa-map me-2 text-success"></i>Zones</h2>
    <a asp-action="CreateZone" class="btn btn-success"><i class="fas fa-plus me-1"></i> Create Zone</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>#</th>
                <th>Name</th>
                <th>Region</th>
                <th>Woredas</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @{ var idx = 0; }
            @foreach (var item in Model)
            {
                idx++;
                <tr>
                    <td>@idx</td>
                    <td><strong>@item.Name</strong></td>
                    <td><span class="badge bg-primary">@item.Region?.Name</span></td>
                    <td><span class="badge bg-info">@item.Woredas.Count</span></td>
                    <td class="text-end">
                        <div class="crud-actions justify-content-end">
                            <a asp-action="ZoneDetails" asp-route-id="@item.ZoneId" class="btn btn-sm btn-outline-info"><i class="fas fa-eye me-1"></i>Details</a>
                            <a asp-action="EditZone" asp-route-id="@item.ZoneId" class="btn btn-sm btn-outline-warning"><i class="fas fa-edit me-1"></i>Edit</a>
                            <a asp-action="DeleteZone" asp-route-id="@item.ZoneId" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash me-1"></i>Delete</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<a asp-action="Index" class="btn-back-pill"><i class="fas fa-chevron-left"></i> Back</a>
