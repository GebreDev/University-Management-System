@model Zone
@{
    ViewData["Title"] = "Edit Zone";
}

<h2><i class="fas fa-map me-2 text-warning"></i>Edit Zone</h2>

<div class="card border-0 shadow-sm mt-3">
    <div class="card-body">
        <form asp-action="EditZone" method="post">
            <input type="hidden" asp-for="ZoneId" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="RegionId" class="form-label">Region</label>
                <select asp-for="RegionId" asp-items="ViewBag.Regions" class="form-select">
                    <option value="">-- Select Region --</option>
                </select>
                <span asp-validation-for="RegionId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-warning"><i class="fas fa-save me-1"></i> Save Changes</button>
            <a asp-action="Zones" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
