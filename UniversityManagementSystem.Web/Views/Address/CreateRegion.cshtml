@model Region
@{
    ViewData["Title"] = "Create Region";
}

<h2><i class="fas fa-globe-africa me-2 text-primary"></i>Create Region</h2>

<div class="card border-0 shadow-sm mt-3">
    <div class="card-body">
        <form asp-action="CreateRegion" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="Enter region name" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i> Create</button>
            <a asp-action="Regions" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
