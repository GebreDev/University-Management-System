@model Woreda
@{
    ViewData["Title"] = "Woreda Details";
}

<h2><i class="fas fa-city me-2 text-warning"></i>@Model.Name</h2>

<div class="card border-0 shadow-sm mt-3 mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Woreda ID</dt>
            <dd class="col-sm-9">@Model.WoredaId</dd>
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>
            <dt class="col-sm-3">Zone</dt>
            <dd class="col-sm-9"><span class="badge bg-success">@Model.Zone?.Name</span></dd>
            <dt class="col-sm-3">Total Kebeles</dt>
            <dd class="col-sm-9"><span class="badge bg-info">@Model.Kebeles.Count</span></dd>
        </dl>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4><i class="fas fa-home me-2 text-danger"></i>Kebeles in @Model.Name</h4>
    <a asp-action="CreateKebele" asp-route-woredaId="@Model.WoredaId" class="btn btn-sm btn-danger">
        <i class="fas fa-plus me-1"></i> Add Kebele
    </a>
</div>

@if (Model.Kebeles.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @{ var idx = 0; }
                @foreach (var kebele in Model.Kebeles.OrderBy(k => k.Name))
                {
                    idx++;
                    <tr>
                        <td>@idx</td>
                        <td>@kebele.Name</td>
                        <td class="text-end">
                            <a asp-action="EditKebele" asp-route-id="@kebele.KebeleId" class="btn btn-sm btn-outline-warning"><i class="fas fa-edit me-1"></i>Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="text-center text-muted py-4">
        <i class="fas fa-inbox fa-2x mb-2"></i>
        <p>No kebeles found in this woreda.</p>
    </div>
}

<a asp-action="Woredas" class="btn-back-pill"><i class="fas fa-chevron-left"></i> Back</a>
