@using Microsoft.AspNetCore.Identity
@using UniversityManagementSystem.Domain.Entities
@using UniversityManagementSystem.Application.Interfaces.Services
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IUserManagementService UserService

@{
    // --- Current page detection for active state ---
    string _ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string _act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string _mod = Context.Request.Query["module"].FirstOrDefault() ?? "";

    // Check if current page matches a specific controller + action(s)
    bool IsActive(string c, params string[] actions)
        => _ctrl.Equals(c, StringComparison.OrdinalIgnoreCase)
        && actions.Any(a => a.Equals(_act, StringComparison.OrdinalIgnoreCase));

    // Check if current page is a specific module
    bool IsModule(string m)
        => _ctrl.Equals("Module", StringComparison.OrdinalIgnoreCase)
        && _mod.Equals(m, StringComparison.OrdinalIgnoreCase);

    // Check if current page is on the Account controller
    bool IsAccount(params string[] actions)
        => _ctrl.Equals("Account", StringComparison.OrdinalIgnoreCase)
        && actions.Any(a => a.Equals(_act, StringComparison.OrdinalIgnoreCase));

    // Check if current page is on the Chat controller
    bool IsChat()
        => _ctrl.Equals("Chat", StringComparison.OrdinalIgnoreCase);

    // Local helper to render a module link (real page served by ModuleController)
    async Task ModuleLink(string module, string label, string icon)
    {
        <li class="sidebar-item">
            <a class="sidebar-link @(IsModule(module) ? "active" : "")" asp-controller="Module" asp-action="Index" asp-route-module="@module">
                <i class="@icon"></i> @label
            </a>
        </li>
        await Task.CompletedTask;
    }
}

<div class="sidebar-search">
    <i class="fas fa-search sidebar-search-icon"></i>
    <input type="search" id="sidebarSearch" class="sidebar-search-input" placeholder="Search menu..." autocomplete="off" aria-label="Search sidebar menu" />
</div>

