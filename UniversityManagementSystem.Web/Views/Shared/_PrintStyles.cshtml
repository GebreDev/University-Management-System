@{
    // This partial adds print functionality. Include with:
    // <partial name="_PrintStyles" model='new PrintViewModel { Title = "Page Title", HideHeaders = new[] { "Actions", "Edit" } }' />
}
@model PrintViewModel

<style>
    @@media print {
        @@page {
            size: A4 portrait;
            margin: 15mm 10mm;
        }
        body {
            font-size: 11pt;
            line-height: 1.4;
        }
        .no-print, .sidebar, #sidebar, #menu-toggle, .navbar, 
        .btn, .btn-group, footer, nav, .breadcrumb,
        .alert-dismissible .btn-close, .stats-card .card-footer a {
            display: none !important;
        }
        .print-only {
            display: block !important;
        }
        .card {
            border: 1px solid #ddd !important;
            box-shadow: none !important;
            border-radius: 4px !important;
            break-inside: avoid;
        }
        .card-header {
            background: #f5f5f5 !important;
            color: #000 !important;
            border-bottom: 2px solid #333 !important;
        }
        .table {
            width: 100% !important;
            border-collapse: collapse !important;
        }
        .table th, .table td {
            border: 1px solid #999 !important;
            padding: 5px 8px !important;
            font-size: 10pt !important;
        }
        .table thead th {
            background: #eaeaea !important;
            color: #000 !important;
            font-weight: bold !important;
        }
        .badge {
            border: 1px solid #666 !important;
            padding: 2px 6px !important;
            font-size: 9pt !important;
        }
        .badge.bg-success { background: #d4edda !important; color: #155724 !important; }
        .badge.bg-danger { background: #f8d7da !important; color: #721c24 !important; }
        .badge.bg-warning { background: #fff3cd !important; color: #856404 !important; }
        .badge.bg-info { background: #d1ecf1 !important; color: #0c5460 !important; }
        .badge.bg-primary { background: #cce5ff !important; color: #004085 !important; }
        .badge.bg-dark { background: #eaeaea !important; color: #333 !important; }
        h1, h2, h3, h4 { break-after: avoid; }
        .print-header {
            text-align: center;
            border-bottom: 2px solid #333;
            padding-bottom: 10px;
            margin-bottom: 20px;
        }
        .print-header h2 { margin-bottom: 0; }
        .print-header small { color: #666; }
        .print-footer {
            position: fixed;
            bottom: 0;
            width: 100%;
            text-align: center;
            font-size: 9pt;
            color: #999;
            border-top: 1px solid #ddd;
            padding-top: 5px;
        }
        @@page {
            @@bottom-right {
                content: "Page " counter(page);
                font-size: 9pt;
                color: #999;
            }
        }
        .progress { display: none !important; }
        .print-summary-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
            margin-bottom: 20px;
        }
        .print-summary-grid .item {
            border: 1px solid #ccc;
            padding: 10px;
            text-align: center;
            border-radius: 4px;
        }
        .print-summary-grid .item strong {
            display: block;
            font-size: 18pt;
        }
    }
    .print-only { display: none; }
    .print-btn {
        transition: all 0.2s ease;
    }
    .print-btn:hover {
        transform: scale(1.05);
    }
</style>

<div class="d-print-none mb-3 d-flex flex-wrap gap-2">
    <button type="button" class="btn btn-outline-dark rounded-pill print-btn" onclick="window.print()">
        <i class="fas fa-print me-2"></i> Print / PDF
    </button>
    <button type="button" class="btn btn-outline-success rounded-pill print-btn" onclick="exportCSV()">
        <i class="fas fa-file-csv me-2"></i> Export CSV
    </button>
    @if (!string.IsNullOrEmpty(Model?.Title))
    {
        <span class="ms-3 text-muted small d-none d-md-inline">
            <i class="fas fa-info-circle me-1"></i> Prints a clean, formatted page
        </span>
    }
</div>

<script>
    // Global variable for column hiding - accessible from both print and export functions
    var printHideHeaders = @Html.Raw(Model?.HideHeaders != null 
        ? System.Text.Json.JsonSerializer.Serialize(Model.HideHeaders) 
        : "[]");

    // Hide specific columns when printing
    document.addEventListener('DOMContentLoaded', function() {
        if (printHideHeaders.length > 0) {
            var tables = document.querySelectorAll('.table');
            tables.forEach(function(table) {
                var headerCells = table.querySelectorAll('thead th');
                var indicesToHide = [];
                headerCells.forEach(function(cell, index) {
                    var text = cell.textContent.trim();
                    if (printHideHeaders.some(function(h) { return text.includes(h); })) {
                        indicesToHide.push(index);
                    }
                });
                // Add a print style that hides those columns
                var style = document.createElement('style');
                var css = '@@media print { ';
                indicesToHide.forEach(function(i) {
                    css += 'table thead th:nth-child(' + (i+1) + '), table tbody td:nth-child(' + (i+1) + ') { display: none !important; } ';
                });
                css += ' }';
                style.textContent = css;
                document.head.appendChild(style);
            });
        }
    });

    // CSV Export Function
    function exportCSV() {
        var tables = document.querySelectorAll('.table');
        if (tables.length === 0) {
            alert('No table data found to export.');
            return;
        }
        
        var csv = [];
        var filename = '@(Model?.Title?.Replace(" ", "_") ?? "export")' || 'export';
        
        tables.forEach(function(table, tableIndex) {
            var rows = table.querySelectorAll('tr');
            if (rows.length === 0) return;
            
            if (tableIndex > 0) csv.push(''); // blank line between tables
            
            rows.forEach(function(row) {
                var cols = row.querySelectorAll('th, td');
                var rowData = [];
                
                cols.forEach(function(col, idx) {
                    var text = col.textContent.trim();
                    // Escape CSV value
                    if (text.includes(',') || text.includes('"') || text.includes('\n')) {
                        text = '"' + text.replace(/"/g, '""') + '"';
                    }
                    rowData.push(text);
                });
                
                if (rowData.length > 0) {
                    csv.push(rowData.join(','));
                }
            });
        });
        
        var blob = new Blob([csv.join('\n')], { type: 'text/csv;charset=utf-8;' });
        var link = document.createElement('a');
        var url = URL.createObjectURL(blob);
        link.setAttribute('href', url);
        link.setAttribute('download', filename + '_' + new Date().toISOString().slice(0,10) + '.csv');
        link.style.visibility = 'hidden';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }
</script>
