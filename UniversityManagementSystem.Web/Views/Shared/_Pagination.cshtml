@model dynamic

@{
    var totalPages = (int)Model.TotalPages;
    var currentPage = (int)Model.Page;
    var totalItems = (int)Model.TotalRecords;
    var pageSize = (int)Model.PageSize;
    var role = Context.Request.Query["role"];
    var search = Context.Request.Query["search"];
}

@if (totalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                <a class="page-link" asp-route-page="@(currentPage - 1)" asp-route-role="@role" asp-route-search="@search">Previous</a>
            </li>
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" asp-route-page="@i" asp-route-role="@role" asp-route-search="@search">@i</a>
                </li>
            }
            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                <a class="page-link" asp-route-page="@(currentPage + 1)" asp-route-role="@role" asp-route-search="@search">Next</a>
            </li>
        </ul>
    </nav>
}
<div class="text-center text-muted small">
    Showing page @currentPage of @totalPages (@totalItems total items)
</div>
