<div class="modal fade" id="siteConfirmModal" tabindex="-1" aria-labelledby="siteConfirmTitle" aria-describedby="siteConfirmMessage">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content site-confirm-card border-0">
            <div class="modal-body p-4 p-sm-5 text-center">
                <div class="site-confirm-icon mb-3" aria-hidden="true">
                    <i class="fas fa-trash-can"></i>
                </div>
                <h2 class="modal-title h4 fw-bold mb-2" id="siteConfirmTitle">Confirm deletion</h2>
                <p class="text-muted mb-4" id="siteConfirmMessage">Are you sure you want to delete this item? This action cannot be undone.</p>
                <div class="d-flex justify-content-center gap-2">
                    <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger px-4" id="siteConfirmAccept">
                        <i class="fas fa-trash-can me-1" aria-hidden="true"></i><span>Delete</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
