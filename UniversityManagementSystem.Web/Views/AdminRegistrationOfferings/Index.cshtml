@model System.Collections.Generic.IEnumerable<UniversityManagementSystem.Domain.Entities.SemesterOfferedCourse>
@{
    ViewData["Title"] = "Manage Semester Offerings";
    var registeredCounts = ViewBag.RegisteredCounts as System.Collections.Generic.IReadOnlyDictionary<int, int>;
}
<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0"><i class="fas fa-list me-2 text-primary"></i>Manage Semester Offerings</h2>
            <small class="text-muted">@ViewBag.SemesterName</small>
        </div>
        <a asp-action="AdminSemesterRegistrations" asp-route-semesterId="@ViewBag.SemesterId" class="btn-back-pill">
            <i class="fas fa-chevron-left"></i>Back
        </a>
    </div>

    <div class="alert alert-secondary">
        <i class="fas fa-info-circle me-1"></i>
        Offerings define which courses students can register for in this semester.
        Each offering has a course, department, capacity, and schedule.
    </div>

    @if (!Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-4">
                <i class="fas fa-clipboard-list fa-3x text-muted mb-3"></i>
                <p class="text-muted mb-0">No offerings have been created for this semester yet.</p>
            </div>
        </div>
    }
    else
    {
    <div class="data-table-wrapper">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Course</th>
                        <th class="text-nowrap">Code</th>
                        <th>Department</th>
                        <th class="text-nowrap" style="width:100px;">Capacity</th>
                        <th class="text-nowrap" style="width:120px;">Registered</th>
                        <th class="text-nowrap" style="width:100px;">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var offering in Model)
                    {
                        var registeredCount = registeredCounts != null && registeredCounts.TryGetValue(offering.Id, out var count) ? count : 0;
                        var seatsLeft = offering.Capacity - registeredCount;
                        var isFull = seatsLeft <= 0;
                        <tr>
                            <td><span class="fw-semibold">@offering.Course?.Title</span></td>
                            <td><span class="code-badge">@offering.Course?.Code</span></td>
                            <td>@offering.Department?.Name</td>
                            <td>@offering.Capacity</td>
                            <td>
                                <span class="status-indicator">
                                    <span class="circle @(isFull ? "danger" : "success")"></span>
                                    @registeredCount / @offering.Capacity
                                </span>
                            </td>
                            <td>
                                <span class="status-indicator">
                                    <span class="circle @(offering.IsOpen ? "success" : "secondary")"></span>
                                    @(offering.IsOpen ? "Open" : "Closed")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="table-footer-count">
            <span>@Model.Count() offering(s)</span>
        </div>
    </div>
    }
</div>
