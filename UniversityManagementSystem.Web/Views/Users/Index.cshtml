@model IEnumerable<UniversityManagementSystem.Web.Models.ViewModels.UserListViewModel>

@{
    ViewData["Title"] = "User Management";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">👤 User Management</h2>
            <p class="text-muted mb-0">Manage all users in the University Management System.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">➕ Create New User</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Search -->
    <div class="card shadow border-0 mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get">
                <div class="input-group">
                    <input type="text" name="search" class="form-control" placeholder="Search by name, email, or username..." value="@ViewBag.Search" />
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-search"></i> Search
                    </button>
                    @if (!string.IsNullOrEmpty(ViewBag.Search as string))
                    {
                        <a asp-action="Index" class="btn btn-secondary">Clear</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- User Table -->
    <div class="card shadow border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th style="width:60px;">#</th>
                            <th>Full Name</th>
                            <th>Username</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th style="width:280px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var number = 1; }
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>@number</td>
                                <td><strong>@user.FullName</strong></td>
                                <td>@user.UserName</td>
                                <td>@user.Email</td>
                                <td>
                                    @if (user.Role == "Admin")
                                    {
                                        <span class="badge bg-danger">Admin</span>
                                    }
                                    else if (user.Role == "Student")
                                    {
                                        <span class="badge bg-info">Student</span>
                                    }
                                    else if (user.Role == "Instructor")
                                    {
                                        <span class="badge bg-success">Instructor</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@user.Role</span>
                                    }
                                </td>
                                <td>
                                    <div class="user-action-group">
                                        <a asp-action="Edit" asp-route-id="@user.Id" class="user-action-btn btn-edit" title="Edit">
                                            <i class="fas fa-edit"></i>
                                            <span>Edit</span>
                                        </a>
                                        <a asp-action="ResetPassword" asp-route-id="@user.Id" class="user-action-btn btn-reset" title="Reset Password">
                                            <i class="fas fa-key"></i>
                                            <span>Reset</span>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@user.Id" class="user-action-btn btn-delete" title="Delete">
                                            <i class="fas fa-trash"></i>
                                            <span>Delete</span>
                                        </a>
                                        @if (user.Role == "Student" && user.ProfileId != null)
                                        {
                                            <a asp-controller="Admin" asp-action="EditStudent" asp-route-id="@user.ProfileId" class="user-action-btn btn-profile" title="Profile">
                                                <i class="fas fa-user-graduate"></i>
                                                <span>Profile</span>
                                            </a>
                                        }
                                        @if (user.Role == "Instructor" && user.ProfileId != null)
                                        {
                                            <a asp-controller="Admin" asp-action="EditInstructor" asp-route-id="@user.ProfileId" class="user-action-btn btn-profile" title="Profile">
                                                <i class="fas fa-chalkboard-user"></i>
                                                <span>Profile</span>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                            number++;
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">No users found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-controller="Roles" asp-action="Index" class="btn btn-secondary">🔐 Manage Roles</a>
    </div>
</div>