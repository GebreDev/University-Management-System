@model UniversityManagementSystem.Web.Models.ViewModels.UserListViewModel

@{
    ViewData["Title"] = "Delete User";
}

<div class="container">
    <h2 class="mb-4">🗑️ Delete User</h2>
    <div class="card shadow border-0">
        <div class="card-body">
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-triangle"></i>
                <strong>Warning:</strong> Are you sure you want to delete this user? This action cannot be undone.
            </div>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />

                <!-- FULL NAME -->
                <div class="mb-3">
                    <label class="form-label">Full Name</label>
                    <input class="form-control" value="@Model.FullName" readonly />
                </div>

                <!-- USERNAME -->
                <div class="mb-3">
                    <label class="form-label">Username</label>
                    <input class="form-control" value="@Model.UserName" readonly />
                </div>

                <!-- EMAIL -->
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input class="form-control" value="@Model.Email" readonly />
                </div>

                <!-- ROLE -->
                <div class="mb-3">
                    <label class="form-label">Role</label>
                    <input class="form-control" value="@Model.Role" readonly />
                </div>

                <!-- ACTIONS -->
                <button type="submit" class="btn btn-danger">🗑️ Delete User</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>