@model AttendanceListDto
@{
    ViewData["Title"] = "Attendance Details";
}            <h2>Attendance Details</h2>

<dl class="row">
    <dt class="col-sm-3">Student</dt>
    <dd class="col-sm-9">@Model.StudentName</dd>
    <dt class="col-sm-3">Course</dt>
    <dd class="col-sm-9">@Model.CourseName</dd>
    <dt class="col-sm-3">Date</dt>
    <dd class="col-sm-9">@Model.Date.ToShortDateString()</dd>
    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9"><span class="badge @(Model.Status == AttendanceStatus.Present ? "bg-success" : Model.Status == AttendanceStatus.Late ? "bg-warning" : Model.Status == AttendanceStatus.Absent ? "bg-danger" : "bg-secondary")">@Model.StatusText</span></dd>
    <dt class="col-sm-3">Remarks</dt>
    <dd class="col-sm-9">@Model.Remarks</dd>
    <dt class="col-sm-3">Marked By</dt>
    <dd class="col-sm-9">@Model.InstructorName</dd>
</dl>

<a asp-action="EditAttendance" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn-back-pill"><i class="fas fa-chevron-left"></i> Back</a>