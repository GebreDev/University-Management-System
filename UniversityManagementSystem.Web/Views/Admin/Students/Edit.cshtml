@model StudentUpdateDto
@{
    ViewData["Title"] = "Edit Student";
    var departments = ViewBag.Departments as IEnumerable<DepartmentListDto>;
}    <h2><i class="fas fa-user-graduate me-2 text-primary"></i>Edit Student</h2>
<form asp-action="EditStudent" method="post">
