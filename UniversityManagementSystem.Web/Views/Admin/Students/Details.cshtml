@model StudentViewDto
@{
    ViewData["Title"] = "Student Details";
}

<h2><i class="fas fa-user-graduate me-2 text-primary"></i>Student Details</h2>

<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0"><i class="fas fa-user me-2"></i>Student Information</h5>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">UGR</dt>
            <dd class="col-sm-9">@Model.StudentId</dd>
            <dt class="col-sm-3">First Name</dt>
            <dd class="col-sm-9">@Model.FirstName</dd>
            <dt class="col-sm-3">Last Name</dt>
            <dd class="col-sm-9">@Model.LastName</dd>
            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>
            <dt class="col-sm-3">Phone</dt>
            <dd class="col-sm-9">@(Model.Phone ?? "N/A")</dd>
            <dt class="col-sm-3">Enrollment Date</dt>
            <dd class="col-sm-9">@Model.EnrollmentDate.ToShortDateString()</dd>
            <dt class="col-sm-3">Department</dt>
            <dd class="col-sm-9">@Model.DepartmentName</dd>
        </dl>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0"><i class="fas fa-book me-2"></i>Enrollments</h5>
    </div>
    <div class="card-body">
        @if (Model.Enrollments != null && Model.Enrollments.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Course</th>
                            <th>Status</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model.Enrollments)
                        {
                            <tr>
                                <td>@e.CourseTitle (@e.CourseCode)</td>
                                <td><span class="badge bg-info">@e.Status</span></td>
                                <td>@e.EnrollmentDate.ToShortDateString()</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted mb-0">No enrollments yet.</p>
        }
    </div>
</div>

<div class="d-flex gap-2">
    <a asp-action="EditStudent" asp-route-id="@Model.Id" class="btn btn-warning">
        <i class="fas fa-edit me-1"></i>Edit
    </a>
    <a asp-action="Students" class="btn-back-pill">
        <i class="fas fa-chevron-left"></i>Back
    </a>
</div>
