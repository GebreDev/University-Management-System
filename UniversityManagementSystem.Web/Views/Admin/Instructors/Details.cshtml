@model InstructorViewDto
@{
    ViewData["Title"] = "Instructor Details";
}

<h2>Instructor Details</h2>
<div>
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.FirstName @Model.LastName</dd>
        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Email</dd>
        <dt class="col-sm-2">Phone</dt>
        <dd class="col-sm-10">@Model.Phone</dd>
        <dt class="col-sm-2">Qualification</dt>
        <dd class="col-sm-10">@Model.Qualification</dd>
        <dt class="col-sm-2">Hire Date</dt>
        <dd class="col-sm-10">@Model.HireDate.ToShortDateString()</dd>
        <dt class="col-sm-2">Department</dt>
        <dd class="col-sm-10">@Model.DepartmentName</dd>
    </dl>
</div>
<h4>Courses</h4>
@if (Model.Courses.Any())
{
    <ul>
        @foreach (var c in Model.Courses)
        {
            <li>@c.Title (@c.Code) - @c.Credits credits</li>
        }
    </ul>
}
else
{
    <p>No courses assigned.</p>
}
<a asp-action="Instructors" class="btn-back-pill"><i class="fas fa-chevron-left"></i> Back</a>