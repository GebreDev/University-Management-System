@model CourseCreateViewModel
@{
    ViewData["Title"] = "Create Course";
    var departments = ViewBag.Departments as IEnumerable<DepartmentListDto>;
    var instructors = ViewBag.Instructors as IEnumerable<InstructorListDto>;
    var academicGrades = ViewBag.AcademicGrades as SelectList;
    var semesters = ViewBag.Semesters as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;

    var romanNumerals = new Dictionary<int, string>
    {
        {1, "I"}, {2, "II"}, {3, "III"}, {4, "IV"}, {5, "V"}, {6, "VI"}, {7, "VII"}
    };
}

<div class="section-card">
    <div class="section-header" style="background: linear-gradient(135deg, #5a9bd5, #3a7cc0);">
        <i class="fas fa-book"></i>
        Create Course
    </div>
    <div class="section-body">
        <form asp-action="CreateCourse" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <!-- Course Name -->
            <div class="mb-3">
                <label asp-for="Title" class="form-label fw-bold">Course Name</label>
                <input asp-for="Title" class="form-control" placeholder="Enter course name" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <!-- Course Code -->
            <div class="mb-3">
                <label asp-for="Code" class="form-label fw-bold">Course Code</label>
                <input asp-for="Code" class="form-control" placeholder="e.g., MATH101, ENG201" />
                <span asp-validation-for="Code" class="text-danger small"></span>
            </div>

            <!-- Description -->
            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-bold">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter course description"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <!-- Credits -->
            <div class="mb-3">
                <label asp-for="Credits" class="form-label fw-bold">Credits</label>
                <input asp-for="Credits" type="number" min="1" max="10" class="form-control" style="max-width: 200px;" />
                <span asp-validation-for="Credits" class="text-danger small"></span>
            </div>

            <!-- Department -->
            <div class="mb-3">
                <label asp-for="DepartmentId" class="form-label fw-bold">Department</label>
                <select asp-for="DepartmentId" class="form-select" asp-items="@(new SelectList(departments, "Id", "Name"))">
                    <option value="">-- Select Department --</option>
                </select>
                <span asp-validation-for="DepartmentId" class="text-danger small"></span>
            </div>

            <!-- Instructor -->
            <div class="mb-3">
                <label asp-for="InstructorId" class="form-label fw-bold">Instructor</label>
                <select asp-for="InstructorId" class="form-select" asp-items="@(new SelectList(instructors, "Id", "FullName"))">
                    <option value="">-- Select Instructor --</option>
                </select>
                <span asp-validation-for="InstructorId" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SemesterId" class="form-label fw-bold">Semester</label>
                <select asp-for="SemesterId" class="form-select" asp-items="semesters">
                    <option value="">-- Select Semester --</option>
                </select>
                <span asp-validation-for="SemesterId" class="text-danger small"></span>
                <div class="form-text">The course will be opened for registration in this semester.</div>
            </div>

            <div class="mb-3">
                <label asp-for="RegistrationCapacity" class="form-label fw-bold">Registration Capacity</label>
                <input asp-for="RegistrationCapacity" type="number" min="1" max="1000" class="form-control" style="max-width: 200px;" />
                <span asp-validation-for="RegistrationCapacity" class="text-danger small"></span>
            </div>

            <!-- Start Date & End Date -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="StartDate" class="form-label fw-bold">Start Date</label>
                    <input asp-for="StartDate" type="date" class="form-control" />
                    <span asp-validation-for="StartDate" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="EndDate" class="form-label fw-bold">End Date</label>
                    <input asp-for="EndDate" type="date" class="form-control" />
                    <span asp-validation-for="EndDate" class="text-danger small"></span>
                </div>
            </div>

            <!-- Select Years (AcademicGrades) -->
            <div class="mb-3">
                <label class="form-label fw-bold">Select Years</label>
                <div class="border rounded p-3" style="max-height: 200px; overflow-y: auto; background: #fafbfc;">
                    @if (academicGrades != null)
                    {
                        @foreach (var grade in academicGrades)
                        {
                            var gradeName = grade.Text;
                            // Check if the grade name is a number and convert to Roman numeral
                            var displayName = gradeName;
                            if (int.TryParse(gradeName, out int gradeNum) && romanNumerals.ContainsKey(gradeNum))
                            {
                                displayName = romanNumerals[gradeNum];
                            }

                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox"
                                       name="SelectedYearIds" value="@grade.Value"
                                       id="year_@grade.Value"
                                       @(Model.SelectedYearIds.Contains(int.Parse(grade.Value)) ? "checked" : "") />
                                <label class="form-check-label" for="year_@grade.Value">
                                    @displayName
                                </label>
                            </div>
                        }
                    }
                </div>
                <small class="text-muted">Select one or more years</small>
            </div>

            <!-- Actions -->
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-check-circle me-1"></i> Save
                </button>
                <a asp-action="Courses" class="btn btn-secondary">
                    <i class="fas fa-times me-1"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
