@model CourseViewDto
@{
    ViewData["Title"] = "Course Details";
}

<h2>Course Details</h2>
<div>
    <dl class="row">
        <dt class="col-sm-2">Title</dt>
        <dd class="col-sm-10">@Model.Title</dd>
        <dt class="col-sm-2">Code</dt>
        <dd class="col-sm-10">@Model.Code</dd>
        <dt class="col-sm-2">Credits</dt>
        <dd class="col-sm-10">@Model.Credits</dd>
        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Description</dd>
        <dt class="col-sm-2">Start Date</dt>
        <dd class="col-sm-10">@Model.StartDate.ToShortDateString()</dd>
        <dt class="col-sm-2">End Date</dt>
        <dd class="col-sm-10">@Model.EndDate.ToShortDateString()</dd>
        <dt class="col-sm-2">Department</dt>
        <dd class="col-sm-10">@Model.DepartmentName</dd>
        <dt class="col-sm-2">Instructor</dt>
        <dd class="col-sm-10">@Model.InstructorName</dd>
    </dl>
</div>
<h4>Enrollments</h4>
@if (Model.Enrollments.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Student</th>
                <th>Student ID</th>
                <th>Status</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model.Enrollments)
            {
                <tr>
                    <td>@e.StudentName</td>
                    <td>@e.StudentId</td>
                    <td>@e.Status</td>
                    <td>@e.EnrollmentDate.ToShortDateString()</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No enrollments.</p>
}
<a asp-action="Courses" class="btn-back-pill"><i class="fas fa-chevron-left"></i> Back</a>