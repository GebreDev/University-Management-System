@model IEnumerable<CourseListDto>
@{
    ViewData["Title"] = "Courses";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="page-title mb-0"><i class="fas fa-book-open me-2 text-primary"></i>Courses</h1>
    <a asp-action="CreateCourse" class="btn btn-primary"><i class="fas fa-plus me-1"></i> Create Course</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="data-table-wrapper">
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Code</th>
                    <th>Credits</th>
                    <th>Instructor</th>
                    <th>Department</th>
                    <th>Enrollments</th>
                    <th class="text-end" style="width:200px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><span class="fw-semibold">@item.Title</span></td>
                        <td><span class="code-badge">@item.Code</span></td>
                        <td>@item.Credits</td>
                        <td>@item.InstructorName</td>
                        <td>@item.DepartmentName</td>
                        <td>@item.EnrollmentCount</td>
                        <td class="text-end">
                            <div class="crud-actions justify-content-end">
                                <a asp-action="DetailsCourse" asp-route-id="@item.Id" class="action-icon view" title="View"><i class="fas fa-eye"></i></a>
                                <a asp-action="EditCourse" asp-route-id="@item.Id" class="action-icon edit" title="Edit"><i class="fas fa-pen-to-square"></i></a>
                                <form asp-action="DeleteCourse" method="post" class="ms-1"
                                      data-confirm-title="Delete course?"
                                      data-confirm-message="Are you sure you want to delete this course? This action cannot be undone.">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="action-icon" style="color:#dc2626;" title="Delete">
                                        <i class="fas fa-trash-can"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="table-footer-count">
        <span>@Model.Count() course(s)</span>
    </div>
</div>