@model UserProfileDto
@{
    ViewData["Title"] = "User Details";
}

<h2>User Details</h2>

<dl class="row">
    <dt class="col-sm-3">Full Name</dt>
    <dd class="col-sm-9">@Model.FirstName @Model.LastName</dd>
    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>
    <dt class="col-sm-3">Phone</dt>
    <dd class="col-sm-9">@Model.PhoneNumber</dd>
    <dt class="col-sm-3">Address</dt>
    <dd class="col-sm-9">@Model.Address</dd>
    <dt class="col-sm-3">Date of Birth</dt>
    <dd class="col-sm-9">@Model.DateOfBirth?.ToShortDateString()</dd>
    <dt class="col-sm-3">Role</dt>
    <dd class="col-sm-9">@Model.Role</dd>
    <dt class="col-sm-3">Joined</dt>
    <dd class="col-sm-9">@Model.CreatedAt.ToShortDateString()</dd>
</dl>

<a asp-action="EditUser" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
<a asp-action="Users" class="btn-back-pill"><i class="fas fa-chevron-left"></i> Back</a>