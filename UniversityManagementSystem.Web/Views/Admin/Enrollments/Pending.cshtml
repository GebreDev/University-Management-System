@model IEnumerable<UniversityManagementSystem.Web.Models.ViewModels.AdminEnrollmentRowViewModel>
@{
    ViewData["Title"] = "Pending Enrollments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="page-title mb-0"><i class="fas fa-clock me-2 text-warning"></i>Pending Enrollments</h1>
    <a asp-action="Enrollments" class="btn btn-outline-secondary"><i class="fas fa-list me-1"></i> All Enrollments</a>
</div>

@if (!Model.Any())
{
    <div class="data-table-wrapper">
        <div class="table-empty-state">
            <i class="fas fa-clock fa-2x mb-2 text-muted"></i>
            <p class="mb-0">No pending enrollments.</p>
        </div>
    </div>
}
else
{
    <div class="data-table-wrapper">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Student</th>
                        <th>Student ID</th>
                        <th>Course</th>
                        <th>Code</th>
                        <th>Semester</th>
                        <th>Enrollment Date</th>
                        <th class="text-end" style="width:160px;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="fw-semibold">@item.StudentFullName</span></td>
                            <td><span class="code-badge">@item.StudentId</span></td>
                            <td><span class="fw-semibold">@item.CourseTitle</span></td>
                            <td><span class="code-badge">@item.CourseCode</span></td>
                            <td>@(string.IsNullOrWhiteSpace(item.SemesterName) ? "—" : item.SemesterName)</td>
                            <td>@item.EnrollmentDate.ToString("M/d/yyyy")</td>
                            <td class="text-end">
                                <div class="crud-actions justify-content-end">
                                    @if (item.RegistrationId.HasValue)
                                    {
                                        <a asp-controller="Registration" asp-action="AdminReview" asp-route-id="@item.RegistrationId" class="action-icon edit" title="Review semester registration">
                                            <i class="fas fa-pen-to-square"></i> Review
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-action="ApproveReject" asp-route-id="@item.Id" class="action-icon edit" title="Approve/Reject">
                                            <i class="fas fa-pen-to-square"></i> Review
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="table-footer-count">
            <span>@Model.Count() pending enrollment(s)</span>
        </div>
    </div>
}
