@model IEnumerable<UniversityManagementSystem.Web.Models.ViewModels.AdminEnrollmentRowViewModel>
@{
    ViewData["Title"] = "All Enrollments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="page-title mb-0"><i class="fas fa-list-check me-2 text-primary"></i>All Enrollments</h1>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="data-table-wrapper">
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Student</th>
                    <th>Student ID</th>
                    <th>Course</th>
                    <th>Semester</th>
                    <th>Status</th>
                    <th>Enrollment Date</th>
                    <th class="text-end" style="width:180px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><span class="fw-semibold">@item.StudentFullName</span></td>
                        <td><span class="code-badge">@item.StudentId</span></td>
                        <td>
                            <span class="fw-semibold">@item.CourseTitle</span>
                            <small class="d-block text-muted"><span class="code-badge">@item.CourseCode</span></small>
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(item.SemesterName) ? "—" : item.SemesterName)</td>
                        <td>
                            <span class="status-indicator">
                                <span class="circle @(item.Status == "Approved" ? "success" : item.Status == "Pending" ? "warning" : "danger")"></span>
                                @item.Status
                            </span>
                        </td>
                        <td>@item.EnrollmentDate.ToString("M/d/yyyy")</td>
                        <td class="text-end">
                            <div class="crud-actions justify-content-end">
                                @if (item.RegistrationId.HasValue)
                                {
                                    <a asp-controller="Registration" asp-action="AdminReview" asp-route-id="@item.RegistrationId" class="action-icon edit" title="Review semester registration">
                                        <i class="fas fa-pen-to-square"></i>
                                    </a>
                                }
                                else
                                {
                                    <a asp-action="ApproveReject" asp-route-id="@item.Id" class="action-icon @(item.Status == "Pending" ? "edit" : "view")" title="@(item.Status == "Pending" ? "Approve/Reject" : "Details")">
                                        <i class="fas @(item.Status == "Pending" ? "fa-pen-to-square" : "fa-eye")"></i>
                                    </a>
                                    <form asp-action="DeleteEnrollment" method="post" class="ms-1"
                                          data-confirm-title="Delete enrollment?"
                                          data-confirm-message="Are you sure you want to delete this enrollment? This action cannot be undone.">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="action-icon" style="color:#dc2626;" title="Delete">
                                            <i class="fas fa-trash-can"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
            }
        </tbody>
    </table>
</div>
<div class="table-footer-count">
    <span>@Model.Count() enrollment(s)</span>
</div>