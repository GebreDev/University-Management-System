@model PromotionOverviewDto
@using UniversityManagementSystem.Application.DTOs.Promotion
@using UniversityManagementSystem.Application.Helpers
@{
    ViewData["Title"] = "Student Promotion";
    var currentYear = Model.CurrentAcademicYearName;
}

<div class="promotion-page">
    <!-- Page Header -->
    <div class="promotion-header">
        <div class="promotion-title-block">
            <h1 class="promotion-title"><i class="fas fa-arrow-up me-2 text-warning"></i> Student Promotion</h1>
            <p class="promotion-subtitle">Academic Year: <strong>@currentYear</strong></p>
        </div>
        <div class="promotion-actions">
            <div class="confirm-group">
                <label class="confirm-label" for="confirmInput">Type PROMOTE ALL to confirm</label>
                <form method="post" asp-action="PromoteAll" class="d-flex align-items-center gap-2 confirm-form">
                    <input type="hidden" name="academicYearId" value="@Model.CurrentAcademicYearId" />
                    <input type="text" name="confirmCode" id="confirmInput"
                           class="form-control form-control-sm confirm-input"
                           placeholder="PROMOTE ALL"
                           autocomplete="off"
                           maxlength="14" />
                    <button type="submit" class="btn btn-success btn-promote-all" id="promoteAllBtn" disabled>
                        <i class="fas fa-arrow-up"></i>
                        <span class="ms-1">Promote All Eligible Students</span>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="stat-card bg-primary bg-opacity-10 border-primary border-end-5">
                <div class="stat-icon"><i class="fas fa-user-graduate text-primary"></i></div>
                <div class="stat-body">
                    <span class="stat-label">Total Students</span>
                    <span class="stat-value fs-3 fw-bold">@Model.TotalStudents</span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card bg-warning bg-opacity-10 border-warning border-end-5">
                <div class="stat-icon"><i class="fas fa-pen-fancy text-warning"></i></div>
                <div class="stat-body">
                    <span class="stat-label">Eligible for Promotion</span>
                    <span class="stat-value fs-3 fw-bold">@Model.TotalEligible</span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card bg-success bg-opacity-10 border-success border-end-5">
                <div class="stat-icon"><i class="fas fa-graduation-cap text-success"></i></div>
                <div class="stat-body">
                    <span class="stat-label">Graduating (Final Year)</span>
                    <span class="stat-value fs-3 fw-bold">@Model.TotalGraduating</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Promotion Table -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th scope="col" class="ps-4">Year</th>
                            <th scope="col">Section</th>
                            <th scope="col" class="text-center">Students</th>
                            <th scope="col" class="text-center">Semester 1</th>
                            <th scope="col" class="text-center">Semester 2</th>
                            <th scope="col" class="text-center">Status</th>
                            <th scope="col" class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Sections.Any())
                        {
                            @foreach (var item in Model.Sections)
                            {
                                var isGraduating = item.IsGraduating;
                                var yearLabel = string.IsNullOrWhiteSpace(item.YearDisplayName)
                                    ? item.YearName
                                    : item.YearDisplayName;
                                var rowClass = isGraduating ? "table-graduating" : "";
                                var badgeClass = item.Status == "Pending"
                                    ? "bg-warning text-dark"
                                    : item.Status == "No Students"
                                        ? "bg-secondary"
                                        : "bg-success";

                                <tr class="@rowClass">
                                    <td class="ps-4 fw-semibold">
                                        <span class="year-badge" title="Academic year: @item.YearName">
                                            <i class="fas fa-layer-group me-1 text-muted"></i>
                                            @yearLabel
                                        </span>
                                        @if (isGraduating)
                                        {
                                            <span class="badge bg-info text-dark ms-1 graduating-badge" title="Final year - students graduate">
                                                <i class="fas fa-graduation-cap"></i> Graduate
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <span class="section-badge">
                                            <i class="fas fa-door-open me-1 text-muted"></i>
                                            @item.SectionName
                                        </span>
                                    </td>
                                    <td class="text-center fw-semibold fs-5">@item.StudentCount</td>
                                    <td class="text-center">
                                        <span class="badge @(item.PendingSemester1 > 0 ? badgeClass : "bg-success") rounded-pill px-3 py-2 small">
                                            @if (item.PendingSemester1 > 0)
                                            {
                                                <text><i class="fas fa-clock me-1"></i>Pending</text>
                                            }
                                            else
                                            {
                                                <text><i class="fas fa-check-circle me-1"></i>Complete</text>
                                            }
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(item.PendingSemester2 > 0 ? badgeClass : "bg-success") rounded-pill px-3 py-2 small">
                                            @if (item.PendingSemester2 > 0)
                                            {
                                                <text><i class="fas fa-clock me-1"></i>Pending</text>
                                            }
                                            else
                                            {
                                                <text><i class="fas fa-check-circle me-1"></i>Complete</text>
                                            }
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @badgeClass rounded-pill px-3 py-2 small status-badge">
                                            @if (item.Status == "Pending")
                                            {
                                                <text><i class="fas fa-clock me-1"></i>@item.Status</text>
                                            }
                                            else if (item.Status == "No Students")
                                            {
                                                <text><i class="fas fa-ban me-1"></i>@item.Status</text>
                                            }
                                            else
                                            {
                                                <text><i class="fas fa-check-circle me-1"></i>@item.Status</text>
                                            }
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        @if (item.StudentCount > 0 && !isGraduating)
                                        {
                                            <form method="post" asp-action="PromoteSection"
                                  asp-route-gradeId="@item.GradeId"
                                  asp-route-sectionName="@item.SectionName"
                                  asp-route-academicYearId="@Model.CurrentAcademicYearId"
                                  class="d-inline">
                                                <button type="submit"
                                                        class="btn btn-outline-primary btn-sm btn-view-promote"
                                                        title="Promote @item.StudentCount student(s) from @yearLabel @item.SectionName">
                                                    <i class="fas fa-arrow-up"></i>
                                                    <span class="ms-1">View / Promote</span>
                                                </button>
                                            </form>
                                        }
                                        else if (isGraduating && item.StudentCount > 0)
                                        {
                                            <button class="btn btn-outline-secondary btn-sm disabled-action"
                                                    title="Final year students graduate instead of promoting"
                                                    disabled>
                                                <i class="fas fa-graduation-cap"></i>
                                                <span class="ms-1">Graduating</span>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">
                                                <i class="fas fa-ban me-1"></i>No students
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="fas fa-info-circle fa-2x mb-2"></i>
                                    <p class="mb-0">No year groups configured. Please set up years under <strong>Timetable &gt; Years</strong>.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

@section Styles {
<style>
    .promotion-page {
        animation: fadeIn 0.3s ease-in-out;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .promotion-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .promotion-title-block {
    }

    .promotion-title {
        font-size: 1.75rem;
        font-weight: 700;
        color: #212529;
        margin: 0 0 0.25rem;
    }

    .promotion-subtitle {
        color: #6c757d;
        margin: 0;
        font-size: 0.95rem;
    }

    .confirm-group {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .confirm-label {
        font-size: 0.8rem;
        color: #495057;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 600;
    }

    .confirm-input {
        width: 180px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 600;
        border: 2px solid #dee2e6;
        border-radius: 6px;
        padding: 0.45rem 0.75rem;
        font-size: 0.9rem;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .confirm-input:focus {
        border-color: #2c6fbf;
        box-shadow: 0 0 0 3px rgba(44, 111, 191, 0.15);
        outline: none;
    }

    .confirm-input.input-valid {
        border-color: #198754;
        background-color: #f0fdf4;
    }

    .confirm-input.input-invalid {
        border-color: #dc3545;
        background-color: #fef2f2;
    }

    .btn-promote-all {
        background-color: #198754;
        border: none;
        padding: 0.5rem 1.25rem;
        border-radius: 6px;
        font-weight: 600;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        transition: all 0.2s;
        white-space: nowrap;
    }

    .btn-promote-all:hover:not(:disabled) {
        background-color: #157347;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(25, 135, 84, 0.3);
    }

    .btn-promote-all:disabled {
        background-color: #6c757d;
        cursor: not-allowed;
        opacity: 0.7;
    }

    .btn-promote-all i {
        font-size: 1rem;
    }

    .stat-card {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.25rem;
        border-radius: 10px;
        background: #fff;
        border-left: 5px solid;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
        transition: box-shadow 0.2s;
    }

    .stat-card:hover {
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    }

    .stat-icon {
        width: 50px;
        height: 50px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    .stat-body {
        display: flex;
        flex-direction: column;
    }

    .stat-label {
        font-size: 0.8rem;
        color: #6c757d;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 600;
    }

    .stat-value {
        color: #212529;
        line-height: 1.2;
    }

    .bg-primary.bg-opacity-10 {
        background-color: rgba(44, 111, 191, 0.08) !important;
    }

    .bg-warning.bg-opacity-10 {
        background-color: rgba(253, 126, 20, 0.08) !important;
    }

    .bg-success.bg-opacity-10 {
        background-color: rgba(25, 135, 84, 0.08) !important;
    }

    .border-end-5 {
        border-right-width: 5px !important;
    }

    .year-badge {
        display: inline-flex;
        align-items: center;
        background: #f8f9fa;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.9rem;
        color: #212529;
        border: 1px solid #dee2e6;
    }

    .section-badge {
        display: inline-flex;
        align-items: center;
        background: #e9ecef;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-weight: 500;
        font-size: 0.9rem;
        color: #495057;
    }

    .graduating-badge {
        font-size: 0.7rem;
        padding: 0.2rem 0.5rem;
    }

    .table-graduating {
        background-color: rgba(255, 213, 79, 0.08) !important;
    }

    .table-graduating td {
        border-color: rgba(255, 213, 79, 0.2);
    }

    .status-badge {
        min-width: 90px;
        text-align: center;
    }

    .btn-view-promote {
        border-radius: 6px;
        font-size: 0.85rem;
        padding: 0.35rem 0.9rem;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        transition: all 0.2s;
    }

    .btn-view-promote:hover {
        background-color: #2c6fbf;
        border-color: #2c6fbf;
        color: #fff;
        transform: translateY(-1px);
    }

    .btn-view-promote i {
        font-size: 0.9rem;
    }

    .disabled-action {
        border-radius: 6px;
        font-size: 0.85rem;
        padding: 0.35rem 0.9rem;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        cursor: not-allowed;
        opacity: 0.6;
    }

    code {
        background: #e9ecef;
        padding: 0.15rem 0.4rem;
        border-radius: 4px;
        font-size: 0.85rem;
        font-weight: 600;
        color: #495057;
    }

    .table thead th {
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.5px;
        padding: 0.85rem 1rem;
    }
</style>
}

@section Scripts {
<script>
    (function () {
        const confirmInput = document.getElementById('confirmInput');
        const promoteAllBtn = document.getElementById('promoteAllBtn');

        if (confirmInput && promoteAllBtn) {
            confirmInput.addEventListener('input', function () {
                const value = this.value.trim();

                if (value === 'PROMOTE ALL') {
                    this.classList.remove('input-invalid');
                    this.classList.add('input-valid');
                    promoteAllBtn.disabled = false;
                } else {
                    this.classList.remove('input-valid');
                    this.classList.add('input-invalid');
                    promoteAllBtn.disabled = true;
                }
            });

            // Initialize state
            if (confirmInput.value.trim() === 'PROMOTE ALL') {
                confirmInput.classList.add('input-valid');
                promoteAllBtn.disabled = false;
            } else {
                confirmInput.classList.add('input-invalid');
                promoteAllBtn.disabled = true;
            }
        }
    })();
</script>
}
