@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>

@{
    ViewData["Title"] = "Role Management";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">🔐 Role Management</h2>
            <p class="text-muted mb-0">Manage the roles available in the University Management System.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">➕ Create New Role</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th style="width:80px;">#</th>
                            <th>Role Name</th>
                            <th style="width:180px;">Type</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var number = 1; }
                        @foreach (var role in Model)
                        {
                            var isSystemRole = role.Name == "Admin" || role.Name == "Instructor" ||
                                               role.Name == "Student";
                            <tr>
                                <td>@number</td>
                                <td><strong>@role.Name</strong></td>
                                <td>
                                    @if (isSystemRole)
                                    {
                                        <span class="badge bg-primary">System Role</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Custom Role</span>
                                    }
                                </td>
                            </tr>
                            number++;
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted py-4">No roles found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-controller="Users" asp-action="Index" class="btn-back-pill"><i class="fas fa-chevron-left"></i> Back</a>
    </div>
</div>