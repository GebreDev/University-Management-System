@model UniversityManagementSystem.Web.Models.ViewModels.RoleCreateViewModel

@{
    ViewData["Title"] = "Create Role";
    var permissions = ViewBag.Permissions as List<string> ?? new List<string>();
}

<div class="container">
    <h2 class="mb-4">🔐 Create New Role</h2>
    <div class="card shadow border-0">
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <!-- ROLE NAME -->
                <div class="mb-4">
                    <label asp-for="RoleName" class="form-label"></label>
                    <input asp-for="RoleName" class="form-control" placeholder="Enter role name" autocomplete="off" />
                    <span asp-validation-for="RoleName" class="text-danger"></span>
                    <div class="form-text">Example: Registrar, Accountant, Academic Coordinator</div>
                </div>

                <!-- PERMISSIONS -->
                <div class="mb-4">
                    <h5 class="mb-3">Permissions</h5>
                    <div class="border rounded p-3">
                        <div class="row">
                            @foreach (var permission in permissions)
                            {
                                <div class="col-md-6 col-lg-4 mb-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox"
                                               name="SelectedPermissions" value="@permission"
                                               id="permission_@permission.Replace(" ", "_")"
                                               @(Model.SelectedPermissions.Contains(permission) ? "checked" : "") />
                                        <label class="form-check-label" for="permission_@permission.Replace(" ", "_")">
                                            @permission
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="form-text mt-2">Select the permissions this role should have.</div>
                </div>

                <!-- ACTIONS -->
                <button type="submit" class="btn btn-primary">➕ Create Role</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}