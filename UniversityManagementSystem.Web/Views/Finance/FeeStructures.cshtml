@model IEnumerable<UniversityManagementSystem.Application.DTOs.Finance.FeeStructureDto>
@{
    ViewData["Title"] = "Fee Structures";
    var years = ViewBag.AcademicYears as SelectList;
    var departments = ViewBag.Departments as SelectList;
    var selectedYearId = (int?)ViewBag.SelectedYearId;
    var selectedDepartmentId = (int?)ViewBag.SelectedDepartmentId;
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <div>
        <h1 class="h2 fw-bold mb-1"><i class="fas fa-tags me-2 text-warning"></i> Fee Structures</h1>
        <small class="text-muted">Price book per department and academic year. Changing prices never alters already-issued invoices.</small>
    </div>
    <a asp-action="Index" class="btn-back-pill"><i class="fas fa-chevron-left"></i> Back</a>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-white py-3 px-4"><h5 class="fw-bold mb-0">Add Fee Item</h5></div>
            <div class="card-body px-4 pb-4">
                <form asp-action="CreateFeeStructure" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Academic Year</label>
                        <select name="AcademicYearId" class="form-select" asp-items="years" required></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Department</label>
                        <select name="DepartmentId" class="form-select" asp-items="departments" required></select>
                        <small class="text-muted">Students are billed using the fee items of their own department.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Item Name</label>
                        <input name="ItemName" class="form-control" placeholder="e.g. Tuition" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Amount - Self Sponsored (ETB)</label>
                        <input name="Amount" type="number" step="0.01" min="0" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Amount - Government Sponsored (ETB)</label>
                        <input name="AmountForGovernmentSponsored" type="number" step="0.01" min="0" class="form-control" value="0" />
                        <small class="text-muted">0 = fully covered by sponsorship.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Due Date (optional)</label>
                        <input name="DueDate" type="date" class="form-control" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100"><i class="fas fa-plus me-1"></i> Add Fee Item</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-white py-3 px-4">
                <form method="get" class="row g-2 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label small text-muted mb-1">Academic Year</label>
                        <select name="academicYearId" class="form-select form-select-sm" asp-items="years">
                            <option value="">All years</option>
                        </select>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label small text-muted mb-1">Department</label>
                        <select name="departmentId" class="form-select form-select-sm" asp-items="departments">
                            <option value="">All departments</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-sm btn-primary w-100">Filter</button>
                    </div>
                </form>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th>Year</th><th>Department</th><th>Item</th>
                                <th class="text-end">Self (ETB)</th>
                                <th class="text-end">Gov. (ETB)</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var fee in Model)
                            {
                                <tr>
                                    <td>@fee.AcademicYearName</td>
                                    <td>@fee.DepartmentName</td>
                                    <td class="fw-semibold">@fee.ItemName</td>
                                    <td class="text-end">@fee.Amount.ToString("N2")</td>
                                    <td class="text-end">@(fee.AmountForGovernmentSponsored > 0 ? fee.AmountForGovernmentSponsored.ToString("N2") : "Covered")</td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editModal-@fee.Id">Edit</button>
                                        <form asp-action="DeleteFeeStructure" method="post" class="d-inline"
                                              data-confirm-title="Remove fee item?"
                                              data-confirm-message="Are you sure you want to remove this fee item? This action cannot be undone."
                                              data-confirm-action="Remove">
                                            <input type="hidden" name="id" value="@fee.Id" />
                                            <button class="btn btn-sm btn-outline-danger">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            @if (!Model.Any())
                            {
                                <tr><td colspan="6" class="text-center text-muted py-4">No fee items defined yet. Add the first one on the left - students are billed from these prices.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@foreach (var fee in Model)
{
    <div class="modal fade" id="editModal-@fee.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="UpdateFeeStructure" method="post">
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold">Edit: @fee.ItemName</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="id" value="@fee.Id" />
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Academic Year</label>
                            <select name="AcademicYearId" class="form-select" asp-items="years" value="@fee.AcademicYearId"></select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Department</label>
                            <select name="DepartmentId" class="form-select" asp-items="departments" value="@fee.DepartmentId"></select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Item Name</label>
                            <input name="ItemName" class="form-control" value="@fee.ItemName" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Amount - Self Sponsored (ETB)</label>
                            <input name="Amount" type="number" step="0.01" min="0" class="form-control" value="@fee.Amount" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Amount - Government Sponsored (ETB)</label>
                            <input name="AmountForGovernmentSponsored" type="number" step="0.01" min="0" class="form-control" value="@fee.AmountForGovernmentSponsored" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Due Date</label>
                            <input name="DueDate" type="date" class="form-control" value="@(fee.DueDate?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="alert alert-info py-2 small mb-0">
                            <i class="fas fa-circle-info me-1"></i> Existing invoices keep their original amounts - only new assessments use the new price.
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
