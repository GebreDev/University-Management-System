@{
    ViewData["Title"] = "Course Registration";
    var semesters = (System.Collections.Generic.IEnumerable<UniversityManagementSystem.Domain.Entities.Semester>?)ViewBag.Semesters
        ?? System.Linq.Enumerable.Empty<UniversityManagementSystem.Domain.Entities.Semester>();
}
<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0"><i class="fas fa-file-signature me-2 text-primary"></i>Course Registration</h2>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="mb-3">Select Semester</h5>
            <form method="post" action="@Url.Action("ChooseSemester", "Registration")">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-6">
                        <select name="semesterId" id="semesterId" class="form-select">
                            <option value="">-- Select Semester --</option>
                            @foreach (var semester in semesters)
                            {
                                <option value="@semester.Id">@semester.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 text-end">
                        <button type="submit" class="btn btn-primary">Open Registration</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
