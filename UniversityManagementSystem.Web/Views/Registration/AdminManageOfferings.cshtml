@model System.Collections.Generic.IEnumerable<UniversityManagementSystem.Domain.Entities.SemesterOfferedCourse>
@{
    ViewData["Title"] = "Manage Offerings";
    var registeredCounts = ViewBag.RegisteredCounts as System.Collections.Generic.IReadOnlyDictionary<int, int>;
}
<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0"><i class="fas fa-cog me-2 text-primary"></i>Manage Offerings</h2>
            <small class="text-muted">Semester: @ViewBag.SemesterName</small>
        </div>
        <a asp-action="AdminSemesterRegistrations" asp-route-semesterId="@ViewBag.SemesterId" class="btn-back-pill btn-sm">
            <i class="fas fa-chevron-left"></i>Back
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Course</th>
                        <th class="text-nowrap">Code</th>
                        <th>Department</th>
                        <th class="text-nowrap" style="width:90px;">Capacity</th>
                        <th class="text-nowrap" style="width:120px;">Registered</th>
                        <th class="text-nowrap" style="width:100px;">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var offering in Model)
                    {
                        var registeredCount = registeredCounts != null && registeredCounts.TryGetValue(offering.Id, out var count) ? count : 0;
                        var seatsLeft = offering.Capacity - registeredCount;
                        var isFull = seatsLeft <= 0;
                        <tr>
                            <td>@offering.Course?.Title</td>
                            <td class="text-muted"><span class="badge bg-secondary">@offering.Course?.Code</span></td>
                            <td class="text-muted">@offering.Department?.Name</td>
                            <td>@offering.Capacity</td>
                            <td>
                                <span class="@(isFull ? "badge bg-danger" : "badge bg-success")">
                                    @registeredCount / @offering.Capacity
                                </span>
                            </td>
                            <td>
                                <span class="badge @(offering.IsOpen ? "bg-success" : "bg-secondary")">
                                    @(offering.IsOpen ? "Open" : "Closed")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
