@model UniversityManagementSystem.Web.Views.Registration.AdminSemesterRegistrationsViewModel
@{
    ViewData["Title"] = "Semester Registrations";
}
<div class="container-fluid px-4 py-4">
    <div class="d-none">@Html.AntiForgeryToken()</div>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0"><i class="fas fa-clipboard-list me-2 text-primary"></i>Semester Registrations</h2>
            <small class="text-muted">@Model.SemesterName</small>
        </div>
        <div>
            <a asp-action="AdminManageOfferings" asp-route-semesterId="@Model.SemesterId" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-cog me-1"></i>Offerings
            </a>
            <a asp-action="AdminIndex" class="btn-back-pill btn-sm">
                <i class="fas fa-chevron-left"></i>Back
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="small text-muted">Pending Review</div>
                    <div class="fs-3 fw-bold">@Model.PendingRegistrations.Count</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="small text-muted">Total Registrations</div>
                    <div class="fs-3 fw-bold">@Model.Registrations.Count</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="small text-muted">Approved</div>
                    <div class="fs-3 fw-bold">@Model.Registrations.Count(r => r.Status == "Approved")</div>
                </div>
            </div>
        </div>
    </div>

    @if (!Model.Registrations.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-4">
                <p class="text-muted mb-0">No registrations found for this semester.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Student</th>
                                <th>Student ID</th>
                                <th>Department</th>
                                <th>Credits</th>
                                <th>Status</th>
                                <th>Submitted</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var reg in Model.Registrations)
                            {
                                var isPending = string.Equals(reg.Status, "Submitted", System.StringComparison.OrdinalIgnoreCase);
                                <tr>
                                    <td>@reg.StudentName</td>
                                    <td class="text-muted">@reg.StudentNumber</td>
                                    <td class="text-muted">@reg.DepartmentName</td>
                                    <td>@reg.TotalCredits</td>
                                    <td>
                                        <span class="badge @(reg.Status == "Approved" ? "bg-success" : reg.Status == "Submitted" ? "bg-warning" : "bg-secondary")">
                                            @reg.Status
                                        </span>
                                    </td>
                                    <td class="text-muted">@reg.CreatedAt.ToShortDateString()</td>
                                    <td class="text-end">
                                        <a asp-action="AdminReview" asp-route-id="@reg.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-eye me-1"></i>Review
                                        </a>
                                        @if (isPending)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-dark"
                                                    onclick="QuickApprove(@reg.Id);"
                                                    title="Approve">
                                                <i class="fas fa-check"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function QuickApprove(id) {
            if (!confirm('Approve this registration?')) return;

            const form = document.createElement('form');
            form.method = 'post';
            form.action = '@Url.Action("AdminReview", "Registration")';

            const idInput = document.createElement('input');
            idInput.type = 'hidden';
            idInput.name = 'Id';
            idInput.value = id;
            form.appendChild(idInput);

            const statusInput = document.createElement('input');
            statusInput.type = 'hidden';
            statusInput.name = 'NewStatus';
            statusInput.value = 'Approved';
            form.appendChild(statusInput);

            const token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (!token) {
                alert('Unable to verify this request. Reload the page and try again.');
                return;
            }

            const tokenInput = document.createElement('input');
            tokenInput.type = 'hidden';
            tokenInput.name = token.name;
            tokenInput.value = token.value;
            form.appendChild(tokenInput);

            document.body.appendChild(form);
            form.submit();
        }
    </script>
}
