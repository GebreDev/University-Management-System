@model UniversityManagementSystem.Application.DTOs.Registration.RegistrationDetailDto
@{
    ViewData["Title"] = "Registration Details";
}
<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0"><i class="fas fa-clipboard-list me-2 text-primary"></i>Registration Details</h2>
            <small class="text-muted">#@Model.Id</small>
        </div>
        <a asp-action="MyRegistrations" class="btn-back-pill btn-sm">
            <i class="fas fa-chevron-left"></i>Back
        </a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="small text-muted">Student</div>
                    <div class="fw-medium">@Model.StudentName</div>
                    <div class="text-muted small">@Model.StudentNumber</div>
                </div>
                <div class="col-md-6">
                    <div class="small text-muted">Semester</div>
                    <div class="fw-medium">@Model.SemesterName</div>
                </div>
                <div class="col-md-6">
                    <div class="small text-muted">Department</div>
                    <div class="fw-medium">@Model.DepartmentName</div>
                </div>
                <div class="col-md-6">
                    <div class="small text-muted">Total Credits</div>
                    <div class="fw-medium">@Model.TotalCredits</div>
                </div>
                <div class="col-md-6">
                    <div class="small text-muted">Status</div>
                    <div>
                        <span class="badge @(Model.Status == "Approved" ? "bg-success" : Model.Status == "Submitted" ? "bg-warning" : Model.Status == "Withdrawn" ? "bg-secondary" : "bg-secondary")">
                            @Model.Status
                        </span>
                    </div>
                </div>
                @if (Model.ReviewedAt.HasValue || !string.IsNullOrEmpty(Model.RejectionReason))
                {
                    <div class="col-md-6">
                        <div class="small text-muted">Reviewed</div>
                        <div class="fw-medium">@Model.ReviewedAt?.ToString("yyyy-MM-dd HH:mm")</div>
                        @if (!string.IsNullOrEmpty(Model.RejectionReason))
                        {
                            <div class="alert alert-danger alert-dismissible fade show mt-2" role="alert">
                                <small>@Model.RejectionReason</small>
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">Selected Courses</h5>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Course</th>
                        <th class="text-nowrap">Code</th>
                        <th class="text-nowrap" style="width:80px;">Credits</th>
                        <th class="text-nowrap" style="width:120px;">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.CourseTitle</td>
                            <td class="text-muted"><span class="badge bg-secondary">@item.CourseCode</span></td>
                            <td>@item.Credits</td>
                            <td>
                                <span class="badge @(item.Status == "Registered" ? "bg-success" : item.Status == "Waitlisted" ? "bg-warning" : "bg-secondary")">
                                    @item.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.StatusHistory.Any())
    {
        <div class="card shadow-sm">
            <div class="card-header">
                <h5 class="mb-0">Status History</h5>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>From</th>
                            <th>To</th>
                            <th class="text-nowrap">Changed At</th>
                            <th>By</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in Model.StatusHistory)
                        {
                            <tr>
                                <td class="text-muted">@h.OldStatus</td>
                                <td><span class="badge bg-primary">@h.NewStatus</span></td>
                                <td class="text-muted text-nowrap">@h.ChangedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@h.ChangedBy</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
