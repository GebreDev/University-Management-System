@model ForgotPasswordDto
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <div class="auth-card-head">
        <span class="auth-card-logo"><i class="fas fa-lock"></i></span>
        <h2>Forgot Password</h2>
        <p>Enter your username to receive a reset link</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3">
            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ResetLink"] != null)
    {
        <div class="alert alert-info shadow-sm rounded-3">
            <i class="fas fa-link me-2"></i>
            <strong class="d-block mb-1">Demo Mode - Reset Link:</strong>
            <small><a href="@TempData["ResetLink"]" class="text-break">@TempData["ResetLink"]</a></small>
        </div>
    }

    <form asp-action="ForgotPassword" method="post" class="auth-form" novalidate>
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <div class="mb-3 forgot-field-wrap">
            <label asp-for="Username" class="form-label forgot-label">Username</label>
            <div class="forgot-input-shell">
                <span class="forgot-input-icon"><i class="fas fa-user"></i></span>
                <input asp-for="Username" class="forgot-input" placeholder="Enter your username" />
            </div>
            <span asp-validation-for="Username" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-auth">
            Send Reset Link <i class="fas fa-paper-plane ms-2"></i>
        </button>
    </form>

    <div class="auth-card-alt">
        <a asp-action="Login" class="btn-back-pill"><i class="fas fa-chevron-left"></i> Back</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
