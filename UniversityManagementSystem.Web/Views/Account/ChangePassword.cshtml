@model ChangePasswordDto
@{
    ViewData["Title"] = "Change Password";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-4 change-password-card">
            <div class="card-header bg-white border-bottom py-3 px-4">
                <h4 class="fw-bold mb-0">Change Password</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="ChangePassword" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label fw-semibold"></label>
                        <div class="position-relative">
                            <input asp-for="CurrentPassword" class="form-control cp-input pe-5" placeholder="Enter old password" autocomplete="current-password" />
                            <button type="button" class="btn btn-link text-muted cp-toggle" data-target="CurrentPassword" aria-label="Show or hide password" tabindex="-1">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-semibold"></label>
                        <div class="position-relative">
                            <input asp-for="NewPassword" class="form-control cp-input pe-5" placeholder="Minimum 8 characters" autocomplete="new-password" />
                            <button type="button" class="btn btn-link text-muted cp-toggle" data-target="NewPassword" aria-label="Show or hide password" tabindex="-1">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmNewPassword" class="form-label fw-semibold"></label>
                        <input asp-for="ConfirmNewPassword" class="form-control cp-input" placeholder="Must match new password" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4 cp-submit">Change Password</button>
                        <a href="javascript:history.back()" class="btn btn-secondary px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .change-password-card {
            max-width: 520px;
            margin: 0 auto;
        }

        .cp-input {
            height: 46px;
            border-radius: 10px;
            border: 1px solid #d7dee5;
            font-size: .95rem;
        }

            .cp-input:focus {
                border-color: var(--bs-primary);
                box-shadow: 0 0 0 .2rem rgba(13, 110, 253, .12);
            }

        .cp-toggle {
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            padding: 4px 8px;
            line-height: 1;
            text-decoration: none;
        }

            .cp-toggle:hover {
                color: var(--bs-primary);
            }

        .cp-submit {
            font-weight: 600;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.cp-toggle').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = document.getElementById(btn.dataset.target);
                if (!input) return;
                var isPassword = input.type === 'password';
                input.type = isPassword ? 'text' : 'password';
                btn.innerHTML = isPassword ? '<i class="fas fa-eye-slash"></i>' : '<i class="fas fa-eye"></i>';
            });
        });
    </script>
}
