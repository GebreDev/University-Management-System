@model ResetPasswordDto
@{
    ViewData["Title"] = "Reset Password";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <div class="auth-card-head">
        <span class="auth-card-logo"><i class="fas fa-key"></i></span>
        <h2>Reset Password</h2>
        <p>Choose a new password for your account</p>
    </div>

    <form asp-action="ResetPassword" method="post" class="auth-form" novalidate>
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
        <input asp-for="Token" type="hidden" />
        <input asp-for="Username" type="hidden" />

        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label">New Password</label>
            <div class="input-icon">
                <i class="fas fa-lock"></i>
                <input asp-for="NewPassword" class="form-control" placeholder="Enter a new password" />
                <button type="button" class="pw-toggle" tabindex="-1" aria-label="Show password" onclick="togglePassword(this)">
                    <i class="far fa-eye"></i>
                </button>
            </div>
            <span asp-validation-for="NewPassword" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ConfirmNewPassword" class="form-label">Confirm New Password</label>
            <div class="input-icon">
                <i class="fas fa-lock"></i>
                <input asp-for="ConfirmNewPassword" class="form-control" placeholder="Repeat new password" />
                <button type="button" class="pw-toggle" tabindex="-1" aria-label="Show password" onclick="togglePassword(this)">
                    <i class="far fa-eye"></i>
                </button>
            </div>
            <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-auth">
            Reset Password <i class="fas fa-key ms-2"></i>
        </button>
    </form>

    <div class="auth-card-alt">
        <a asp-action="Login" class="btn-back-pill"><i class="fas fa-chevron-left"></i> Back</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
