@model IEnumerable<AcademicYear>
@{
    ViewData["Title"] = "Manage Academic Years";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .my-page { padding: 10px 0 40px; }

    .my-header {
        background: linear-gradient(135deg, var(--btn-sky), var(--btn-sky-hover));
        color: white;
        border-radius: 14px 14px 0 0;
        padding: 22px 28px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .my-header-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .my-header i { font-size: 1.2rem; }
    .my-header h3 { font-weight: 700; margin: 0; font-size: 1.15rem; }

    .my-body {
        background: white;
        border: 1px solid #e8eef3;
        border-top: 0;
        border-radius: 0 0 14px 14px;
        padding: 24px 28px;
        box-shadow: 0 2px 8px rgba(0,0,0,.04);
    }

    .my-table {
        width: 100%;
        border-collapse: collapse;
    }
    .my-table thead th {
        background: #1e293b;
        color: white;
        font-weight: 700;
        font-size: .82rem;
        text-transform: uppercase;
        letter-spacing: .4px;
        padding: 12px 14px;
        text-align: left;
    }
    .my-table tbody td {
        padding: 14px;
        border-bottom: 1px solid #f1f5f9;
        font-size: .88rem;
        color: #334155;
    }
    .my-table tbody tr:last-child td { border-bottom: none; }
    .my-table tbody tr:hover td { background: #f8fbfe; }

    .badge-current {
        background: #dcfce7;
        color: #16a34a;
        padding: 4px 12px;
        border-radius: 12px;
        font-size: .75rem;
        font-weight: 700;
    }
    .badge-past {
        background: #f1f5f9;
        color: #64748b;
        padding: 4px 12px;
        border-radius: 12px;
        font-size: .75rem;
        font-weight: 700;
    }

    .btn-create-year {
        background: white;
        color: var(--btn-sky);
        border: none;
        border-radius: 10px;
        padding: 8px 18px;
        font-weight: 700;
        font-size: .85rem;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: all .2s ease;
    }
    .btn-create-year:hover {
        background: #f0f7ff;
        color: var(--btn-sky-hover);
    }

    .my-empty {
        text-align: center;
        padding: 40px 20px;
    }
    .my-empty i { font-size: 40px; color: #d0dce4; margin-bottom: 12px; }
    .my-empty h5 { color: #1e293b; font-weight: 700; }
    .my-empty p { color: #64748b; }
</style>

<div class="my-page">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Header -->
    <div class="my-header">
        <div class="my-header-left">
            <i class="fas fa-calendar-check"></i>
            <h3>Academic Years</h3>
        </div>
        <a asp-action="CreateAcademicYear" class="btn-create-year">
            <i class="fas fa-plus"></i> Create Academic Year
        </a>
    </div>

    <div class="my-body">
        @if (Model.Any())
        {
            <div style="overflow-x: auto;">
                <table class="my-table">
                    <thead>
                        <tr>
                            <th style="width:60px;">No</th>
                            <th>Name</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Status</th>
                            <th style="width:140px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var idx = 0; }
                        @foreach (var item in Model)
                        {
                            idx++;
                            <tr>
                                <td class="fw-bold">@idx</td>
                                <td class="fw-bold">@item.Name</td>
                                <td>@item.StartDate.ToString("MMM dd, yyyy")</td>
                                <td>@item.EndDate.ToString("MMM dd, yyyy")</td>
                                <td>
                                    @if (item.IsCurrent)
                                    {
                                        <span class="badge-current">Current</span>
                                    }
                                    else
                                    {
                                        <span class="badge-past">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="ManageSemesters" asp-route-yearId="@item.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-list me-1"></i> Semesters
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="my-empty">
                <i class="fas fa-calendar-xmark"></i>
                <h5>No Academic Years</h5>
                <p>Create your first academic year to get started.</p>
                <a asp-action="CreateAcademicYear" class="btn btn-primary mt-2">
                    <i class="fas fa-plus me-1"></i> Create Academic Year
                </a>
            </div>
        }
    </div>
</div>
