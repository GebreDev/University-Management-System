@model UniversityManagementSystem.Domain.Entities.TimetableSetting
@{
    ViewData["Title"] = "Timetable Settings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .ts-page { padding: 10px 0 40px; max-width: 800px; }

    .ts-header {
        background: linear-gradient(135deg, var(--btn-sky), var(--btn-sky-hover));
        color: white;
        border-radius: 16px;
        padding: 28px 32px;
        margin-bottom: 24px;
        position: relative;
        overflow: hidden;
    }
    .ts-header::after {
        content: "";
        position: absolute;
        right: -30px;
        top: -30px;
        width: 120px;
        height: 120px;
        background: rgba(255,255,255,.08);
        border-radius: 50%;
    }
    .ts-header h3 { font-weight: 700; margin-bottom: 4px; font-size: 1.3rem; }
    .ts-header p { opacity: .85; font-size: .88rem; margin: 0; }
    .ts-header .badge-admin {
        position: absolute;
        right: 24px;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(255,255,255,.18);
        border: 1px solid rgba(255,255,255,.25);
        border-radius: 20px;
        padding: 6px 16px;
        font-size: .78rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .ts-card {
        background: white;
        border: 1px solid #e8eef3;
        border-radius: 14px;
        padding: 24px 28px;
        margin-bottom: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,.04);
    }
    .ts-card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 6px;
    }
    .ts-card-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: #1e293b;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .ts-card-title i { color: var(--btn-sky); font-size: .95rem; }
    .ts-card-subtitle {
        font-size: .82rem;
        color: #64748b;
        margin-bottom: 0;
    }
    .ts-badge {
        background: #eef4fb;
        color: var(--btn-sky);
        border-radius: 20px;
        padding: 4px 14px;
        font-size: .78rem;
        font-weight: 700;
        white-space: nowrap;
        border: 1px solid #d4e4f4;
    }
    .ts-days-badge {
        background: #eef4fb;
        color: var(--btn-sky);
        border-radius: 20px;
        padding: 8px 18px;
        font-size: .85rem;
        font-weight: 700;
        white-space: nowrap;
        border: 1px solid #d4e4f4;
        text-align: center;
        line-height: 1.2;
    }
    .ts-days-badge small {
        display: block;
        font-size: .65rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .5px;
        color: #5a8ab5;
    }

    .day-row {
        display: flex;
        align-items: center;
        padding: 14px 0;
        border-bottom: 1px solid #f1f5f9;
    }
    .day-row:last-child { border-bottom: none; }
    .day-num {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #f1f5f9;
        color: #64748b;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .82rem;
        font-weight: 700;
        flex-shrink: 0;
        margin-right: 14px;
    }
    .day-info { flex: 1; }
    .day-name {
        font-weight: 700;
        color: #1e293b;
        font-size: .92rem;
        margin-bottom: 1px;
    }
    .day-desc {
        font-size: .78rem;
        color: #94a3b8;
    }
    .day-status {
        font-size: .75rem;
        font-weight: 700;
        padding: 3px 12px;
        border-radius: 12px;
        margin-right: 14px;
    }
    .day-status.enabled {
        background: #dcfce7;
        color: #16a34a;
    }
    .day-status.disabled {
        background: #f1f5f9;
        color: #94a3b8;
    }

    /* Toggle switch */
    .ts-toggle {
        position: relative;
        width: 48px;
        height: 26px;
        flex-shrink: 0;
    }
    .ts-toggle input { opacity: 0; width: 0; height: 0; }
    .ts-toggle .slider {
        position: absolute;
        cursor: pointer;
        top: 0; left: 0; right: 0; bottom: 0;
        background: #cbd5e1;
        border-radius: 26px;
        transition: .3s;
    }
    .ts-toggle .slider::before {
        content: "";
        position: absolute;
        height: 20px;
        width: 20px;
        left: 3px;
        bottom: 3px;
        background: white;
        border-radius: 50%;
        transition: .3s;
        box-shadow: 0 1px 3px rgba(0,0,0,.15);
    }
    .ts-toggle input:checked + .slider { background: var(--btn-sky); }
    .ts-toggle input:checked + .slider::before { transform: translateX(22px); }

    .ts-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 28px;
    }
    .ts-footer a {
        color: #64748b;
        text-decoration: none;
        font-size: .88rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .ts-footer a:hover { color: var(--btn-sky); }
    .btn-save-settings {
        background: linear-gradient(135deg, var(--btn-sky), var(--btn-sky-hover));
        color: white;
        border: none;
        border-radius: 10px;
        padding: 10px 28px;
        font-weight: 700;
        font-size: .9rem;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: all .2s ease;
        box-shadow: 0 4px 12px rgba(74,144,226,.3);
    }
    .btn-save-settings:hover {
        background: linear-gradient(135deg, var(--btn-sky-hover), var(--btn-sky-deep));
        color: white;
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(74,144,226,.4);
    }

    @@media (max-width: 768px) {
        .ts-header { padding: 22px 18px; }
        .ts-header .badge-admin { position: static; transform: none; margin-top: 12px; display: inline-flex; }
        .ts-card { padding: 18px 16px; }
        .day-row { flex-wrap: wrap; gap: 8px; }
    }
</style>

<div class="ts-page">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Header -->
    <div class="ts-header">
        <div>
            <h3><i class="fas fa-calendar-alt me-2"></i>Timetable Settings</h3>
            <p>Configure the working days available for timetable scheduling</p>
        </div>
        <div class="badge-admin">
            <i class="fas fa-user-shield"></i> Administrator
        </div>
    </div>

    <form asp-action="TimetableSettings" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="UniversityName" />
        <input type="hidden" asp-for="DayStartTime" />
        <input type="hidden" asp-for="DayEndTime" />
        <input type="hidden" asp-for="PeriodsPerDay" />
        <input type="hidden" asp-for="LunchBreakStart" />
        <input type="hidden" asp-for="LunchBreakEnd" />
        <input type="hidden" asp-for="LunchBreakDurationMinutes" />
        <input type="hidden" asp-for="MondayLabel" />
        <input type="hidden" asp-for="TuesdayLabel" />
        <input type="hidden" asp-for="WednesdayLabel" />
        <input type="hidden" asp-for="ThursdayLabel" />
        <input type="hidden" asp-for="FridayLabel" />
        <input type="hidden" asp-for="SaturdayLabel" />
        <input type="hidden" asp-for="IsActive" />

        @{
            var days = new (string Name, string Prop, bool Default, string Desc)[]
            {
                ("Monday", "MondayEnabled", true, "Available for timetable scheduling"),
                ("Tuesday", "TuesdayEnabled", true, "Available for timetable scheduling"),
                ("Wednesday", "WednesdayEnabled", true, "Available for timetable scheduling"),
                ("Thursday", "ThursdayEnabled", true, "Available for timetable scheduling"),
                ("Friday", "FridayEnabled", true, "Available for timetable scheduling"),
                ("Saturday", "SaturdayEnabled", false, "Currently excluded from timetable scheduling"),
                ("Sunday", "SundayEnabled", false, "Currently excluded from timetable scheduling")
            };

            var enabledCount = 0;
            if (Model.MondayEnabled) enabledCount++;
            if (Model.TuesdayEnabled) enabledCount++;
            if (Model.WednesdayEnabled) enabledCount++;
            if (Model.ThursdayEnabled) enabledCount++;
            if (Model.FridayEnabled) enabledCount++;
            if (Model.SaturdayEnabled) enabledCount++;
            if (Model.SundayEnabled) enabledCount++;
        }

        <!-- Working Days Summary -->
        <div class="ts-card">
            <div class="ts-card-header">
                <div>
                    <div class="ts-card-title">
                        <i class="fas fa-briefcase"></i> Working Days
                    </div>
                    <p class="ts-card-subtitle">Enabled days will appear throughout timetable scheduling</p>
                </div>
                <div class="ts-days-badge">
                    @enabledCount
                    <small>Days Enabled</small>
                </div>
            </div>
        </div>

        <!-- Weekly Schedule -->
        <div class="ts-card">
            <div class="ts-card-header">
                <div>
                    <div class="ts-card-title">
                        <i class="fas fa-calendar-week"></i> Weekly Schedule
                    </div>
                    <p class="ts-card-subtitle">Turn a day on or off for timetable scheduling</p>
                </div>
                <div class="ts-badge">7 Days</div>
            </div>

            @{
                var dayProps = new[] {
                    (Label: "Monday",    Prop: "MondayEnabled",    Val: Model.MondayEnabled),
                    (Label: "Tuesday",   Prop: "TuesdayEnabled",   Val: Model.TuesdayEnabled),
                    (Label: "Wednesday", Prop: "WednesdayEnabled", Val: Model.WednesdayEnabled),
                    (Label: "Thursday",  Prop: "ThursdayEnabled",  Val: Model.ThursdayEnabled),
                    (Label: "Friday",    Prop: "FridayEnabled",    Val: Model.FridayEnabled),
                    (Label: "Saturday",  Prop: "SaturdayEnabled",  Val: Model.SaturdayEnabled),
                    (Label: "Sunday",    Prop: "SundayEnabled",    Val: Model.SundayEnabled)
                };
                int num = 1;
            }

            @foreach (var d in dayProps)
            {
                var isEnabled = d.Val;
                <div class="day-row">
                    <div class="day-num">@num</div>
                    <div class="day-info">
                        <div class="day-name">@d.Label</div>
                        <div class="day-desc">@(isEnabled ? "Available for timetable scheduling" : "Currently excluded from timetable scheduling")</div>
                    </div>
                    <span class="day-status @(isEnabled ? "enabled" : "disabled")">@(isEnabled ? "Enabled" : "Disabled")</span>
                    <label class="ts-toggle">
                        @* Checkbox first, hidden fallback AFTER it: the model binder takes
                           the FIRST posted value, so a checked box now binds as true. *@
                        <input type="checkbox" name="@d.Prop" value="true" @(isEnabled ? "checked" : "") />
                        <input type="hidden" name="@d.Prop" value="false" />
                        <span class="slider"></span>
                    </label>
                </div>
                num++;
            }
        </div>

        <!-- Footer -->
        <div class="ts-footer">
            <a asp-action="ShowTimetable" class="btn-back-pill">
                <i class="fas fa-chevron-left"></i> Back
            </a>
            <button type="submit" class="btn-save-settings">
                <i class="fas fa-save"></i> Save Settings
            </button>
        </div>
    </form>
</div>
