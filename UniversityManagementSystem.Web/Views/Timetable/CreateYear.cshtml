@model AcademicYear
@{
    ViewData["Title"] = "Add Academic Year";
}

<h2><i class="fas fa-calendar me-2 text-primary"></i>Add Academic Year</h2>

<div class="card border-0 shadow-sm mt-3">
    <div class="card-body">
        <form asp-action="CreateYear" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label">Academic Year</label>
                <input asp-for="Name" class="form-control" placeholder="e.g. 2025/2026" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3 form-check">
                <input asp-for="IsCurrent" class="form-check-input" />
                <label asp-for="IsCurrent" class="form-check-label">Mark as current year</label>
            </div>
            <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i> Create</button>
            <a asp-action="ManageYears" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
