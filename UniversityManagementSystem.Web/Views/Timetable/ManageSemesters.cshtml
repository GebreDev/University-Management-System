@model IEnumerable<Semester>
@{
    ViewData["Title"] = "Manage Semesters";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><i class="fas fa-clock me-2 text-primary"></i>Semesters</h2>
    <a asp-action="CreateSemester" class="btn btn-primary"><i class="fas fa-plus me-1"></i> Add Semester</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>#</th>
                <th>Name</th>
                <th>Academic Year</th>
            </tr>
        </thead>
        <tbody>
            @{ var idx = 0; }
            @foreach (var item in Model)
            {
                idx++;
                <tr>
                    <td>@idx</td>
                    <td><strong>@item.Name</strong></td>
                    <td><span class="badge bg-primary">@item.AcademicYear?.Name</span></td>
                </tr>
            }
        </tbody>
    </table>
</div>

<a asp-action="ManageYears" class="btn-back-pill"><i class="fas fa-chevron-left"></i> Back</a>
